<section class="digvolly-hero" aria-label="Hero">
  <div class="digvolly-hero__gradient-blob"></div>
  <div class="digvolly-hero__content">
    <h1 class="digvolly-hero__title">
      {{ section.settings.heading | default: 'Premium Digital Assets for Creators' }}
    </h1>
    <p class="digvolly-hero__subtitle">
      {{ section.settings.subtitle | default: 'Download instantly. Create without limits.' }}
    </p>
    <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="digvolly-hero__button">
      {{ section.settings.button_label | default: 'Browse Collection' }}
    </a>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Premium Digital Assets for Creators"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Download instantly. Create without limits."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Browse Collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
