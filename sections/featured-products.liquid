<section class="featured-products-section" aria-label="Products">
  <div class="products-grid">
    <div class="product-card">
      <div class="product-card__image product-card__image--1"></div>
      <div class="product-card__content">
        <h3 class="product-card__title">Creator UI Kit Bundle</h3>
        <div class="product-card__price">$15.00</div>
        <button type="button" class="product-card__button">Add to Cart</button>
      </div>
    </div>
    <div class="product-card">
      <div class="product-card__image product-card__image--2"></div>
      <div class="product-card__content">
