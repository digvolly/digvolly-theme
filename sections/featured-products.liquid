<section class="featured-products-section" aria-label="Featured Products">
  <div class="featured-products-container">
    <div class="section-header text-center">
      <span class="hero-tag">Featured Digital Drops</span>
      <h2 class="section-title">Trending Creative Packs</h2>
      <p class="section-subtitle">Handcrafted pattern swatches, presentation kits, and artisan papers ready for your next project.</p>
    </div>

    <div class="products-grid">
      {%- assign featured_collection = section.settings.collection -%}
      {%- if featured_collection != blank and featured_collection.products.size > 0 -%}
        {%- for product in featured_collection.products limit: section.settings.products_to_show -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- elsif collections['all'] != blank and collections['all'].products.size > 0 -%}
        {%- for product in collections['all'].products limit: section.settings.products_to_show -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {% render 'product-card',
          title: 'Geometric Repeat Pack',
          price: '$15.00',
          compare_at_price: '$25.00',
          badge: 'Save 40%',
          category: 'Patterns',
          formats: 'AI, EPS, SVG, PNG',
          primary_image: 'mockup-geometric-pack.svg',
          secondary_image: 'mockup-geometric-pack-hover.svg',
          url: routes.all_products_collection_url
        %}

        {% render 'product-card',
          title: 'Pitch Deck Pro Template',
          price: '$15.00',
          category: 'Templates',
          badge: 'Bestseller',
          formats: 'PPTX, KEY, FIGMA',
          primary_image: 'mockup-pitch-deck.svg',
          secondary_image: 'mockup-pitch-deck-hover.svg',
          url: routes.all_products_collection_url
        %}

        {% render 'product-card',
          title: 'Watercolor Textured Papers',
          price: '$15.00',
          category: 'Papers',
          badge: 'New',
          formats: 'JPG 600DPI, PNG',
          primary_image: 'mockup-watercolor-papers.svg',
          secondary_image: 'mockup-watercolor-papers-hover.svg',
          url: routes.all_products_collection_url
        %}

        {% render 'product-card',
          title: '3D Vector Graphics Pack',
          price: '$15.00',
          category: 'Graphics',
          formats: 'PNG, BLENDER, AI',
          primary_image: 'mockup-vector-graphics.svg',
          secondary_image: 'mockup-vector-graphics-hover.svg',
          url: routes.all_products_collection_url
        %}

        {% render 'product-card',
          title: 'Brand Identity Starter Kit',
          price: '$15.00',
          compare_at_price: '$30.00',
          badge: 'Save 50%',
          category: 'Templates',
          formats: 'AI, EPS, INDD, FIGMA',
          primary_image: 'mockup-branding-kit.svg',
          secondary_image: 'mockup-branding-kit-hover.svg',
          url: routes.all_products_collection_url
        %}

        {% render 'product-card',
          title: 'Social Media Creator Bundle',
          price: '$15.00',
          category: 'Templates',
          badge: 'Popular',
          formats: 'CANVA, FIGMA, PSD',
          primary_image: 'mockup-social-templates.svg',
          secondary_image: 'mockup-social-templates-hover.svg',
          url: routes.all_products_collection_url
        %}

        {% render 'product-card',
          title: 'Minimalist Typography Kit',
          price: '$15.00',
          category: 'Graphics',
          formats: 'OTF, TTF, WOFF2',
          primary_image: 'mockup-typography-kit.svg',
          secondary_image: 'mockup-typography-kit-hover.svg',
          url: routes.all_products_collection_url
        %}

        {% render 'product-card',
          title: 'Mobile UI Design System',
          price: '$15.00',
          category: 'Templates',
          badge: 'New',
          formats: 'FIGMA, SKETCH, XD',
          primary_image: 'mockup-mobile-ui.svg',
          secondary_image: 'mockup-mobile-ui-hover.svg',
          url: routes.all_products_collection_url
        %}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Products",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 16,
      "step": 2,
      "default": 8,
      "label": "Products to show"
    }
  ],
  "presets": [
    {
      "name": "Featured Products"
    }
  ]
}
{% endschema %}
