<section class="digvolly-hero" style="background: #FFFFFF radial-gradient(ellipse at top right, rgba(167,139,250,0.3) 0%, rgba(255,255,255,0) 50%);" aria-label="Hero">
  <div class="digvolly-hero__gradient-blob"></div>
  <div class="digvolly-hero__content">
    <h1 class="digvolly-hero__title">
      {{ section.settings.heading | default: 'Premium Digital Assets for Creators' }}
    </h1>
    <p class="digvolly-hero__subtitle">
      {{ section.settings.text | default: 'Download instantly. Create without limits.' }}
    </p>
    {%- assign rich_btn_url = section.settings.button_link -%}
    {%- if rich_btn_url == blank or rich_btn_url == '/collections' or rich_btn_url == 'shopify://collections' or rich_btn_url == routes.collections_url -%}
      {%- assign rich_btn_url = routes.all_products_collection_url -%}
    {%- endif -%}
    <a href="{{ rich_btn_url }}" class="digvolly-hero__button">
      {{ section.settings.button_label | default: 'Browse Collection' }}
    </a>
  </div>
</section>

{% schema %}
{
  "name": "Rich Text",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Premium Digital Assets for Creators"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Download instantly. Create without limits."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Browse Collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Rich Text"
    }
  ]
}
{% endschema %}
