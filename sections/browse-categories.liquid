{%- liquid
  assign section_tag = section.settings.tag | default: 'Curated Collections'
  assign section_title = section.settings.title | default: 'Browse by Category'
  assign section_subtitle = section.settings.subtitle | default: 'Find the exact design toolkit you need for your next creative project.'
-%}

<section class="browse-categories-section" aria-label="Browse Digital Asset Categories">
  <div class="homepage-section-container">
    <div class="section-header text-center">
      {%- if section_tag != blank -%}
        <span class="hero-tag">{{ section_tag }}</span>
      {%- endif -%}
      {%- if section_title != blank -%}
        <h2 class="section-title">{{ section_title }}</h2>
      {%- endif -%}
      {%- if section_subtitle != blank -%}
        <p class="section-subtitle">{{ section_subtitle }}</p>
      {%- endif -%}
    </div>

    <div class="browse-categories-grid browse-categories-grid--5">
      {%- for i in (1..5) -%}
        {%- liquid
          case i
            when 1
              assign card_image = section.settings.card_1_image
              assign card_collection = section.settings.card_1_collection
              assign card_title = section.settings.card_1_title | default: 'Patterns'
              assign card_desc = section.settings.card_1_desc | default: 'Seamless vector pattern repeats, modern abstract textures, and handcrafted motifs in AI, EPS & SVG.'
              assign card_url_fallback = '/collections/patterns'
              assign card_fallback_img = 'mockup-geometric-pack.svg'
              assign card_fallback_alt = 'Seamless Vector Patterns — repeatable geometric and floral swatches preview'
            when 2
              assign card_image = section.settings.card_2_image
              assign card_collection = section.settings.card_2_collection
              assign card_title = section.settings.card_2_title | default: 'Flyer & Posters'
              assign card_desc = section.settings.card_2_desc | default: 'Eye-catching flyers and posters for events, business promotions, and nightlife — fully editable print-ready templates.'
              assign card_url_fallback = '/collections/flyer'
              assign card_fallback_img = 'mockup-pitch-deck.svg'
              assign card_fallback_alt = 'Flyer & Poster Templates — editable print-ready promotional designs preview'
            when 3
              assign card_image = section.settings.card_3_image
              assign card_collection = section.settings.card_3_collection
              assign card_title = section.settings.card_3_title | default: 'Wedding Invitations'
              assign card_desc = section.settings.card_3_desc | default: 'Elegant watercolor and floral invitation suites — save the dates, RSVPs, and more, easy to customize.'
              assign card_url_fallback = '/collections/wedding-invitations'
              assign card_fallback_img = 'mockup-ebooks.svg'
              assign card_fallback_alt = 'Wedding Invitation Templates — elegant watercolor and floral suites preview'
            when 4
              assign card_image = section.settings.card_4_image
              assign card_collection = section.settings.card_4_collection
              assign card_title = section.settings.card_4_title | default: 'Menus'
              assign card_desc = section.settings.card_4_desc | default: 'Restaurant and cafe menu templates — trifold, rustic, and modern styles ready to print or edit.'
              assign card_url_fallback = '/collections/menus'
              assign card_fallback_img = 'mockup-geometric-pack.svg'
              assign card_fallback_alt = 'Restaurant Menu Templates — trifold and modern styles preview'
            when 5
              assign card_image = section.settings.card_5_image
              assign card_collection = section.settings.card_5_collection
              assign card_title = section.settings.card_5_title | default: 'Invoices'
              assign card_desc = section.settings.card_5_desc | default: 'Clean, professional invoice templates for freelancers and agencies.'
              assign card_url_fallback = '/collections/invoices'
              assign card_fallback_img = 'mockup-pitch-deck.svg'
              assign card_fallback_alt = 'Invoice Templates — clean professional layouts for freelancers preview'
          endcase

          if card_collection != blank
            assign card_url = card_collection.url
            assign card_count = card_collection.all_products_count
          else
            assign card_url = card_url_fallback
            assign card_count = 0
          endif
        -%}

        <a href="{{ card_url }}" class="category-showcase-card card glass-panel" aria-label="Browse {{ card_title }} Collection">
          <div class="category-showcase-card__img-wrap">
            {%- if card_image != blank -%}
              <img 
                src="{{ card_image | image_url: width: 600 }}" 
                srcset="{{ card_image | image_url: width: 350 }} 350w, {{ card_image | image_url: width: 450 }} 450w, {{ card_image | image_url: width: 600 }} 600w, {{ card_image | image_url: width: 800 }} 800w"
                sizes="(max-width: 768px) calc(100vw - 40px), (max-width: 1024px) 45vw, 380px"
                alt="{{ card_image.alt | default: card_title | escape }}" 
                class="category-showcase-card__img" 
                width="{{ card_image.width | default: 600 }}" 
                height="{{ card_image.height | default: 400 }}" 
                loading="lazy"
                decoding="async"
              >
            {%- else -%}
              <img 
                src="{{ card_fallback_img | asset_url }}" 
                alt="{{ card_fallback_alt }}" 
                class="category-showcase-card__img" 
                width="600" 
                height="400" 
                loading="lazy"
                decoding="async"
              >
            {%- endif -%}
            {%- if card_count > 0 -%}
              <span class="category-showcase-card__badge">{{ card_count }}+ Products</span>
            {%- endif -%}
          </div>
          <div class="category-showcase-card__content">
            <div class="category-showcase-card__header">
              <h3 class="category-showcase-card__title">{{ card_title }}</h3>
              <span class="category-showcase-card__arrow" aria-hidden="true">&rarr;</span>
            </div>
            {%- if card_desc != blank -%}
              <p class="category-showcase-card__desc">{{ card_desc }}</p>
            {%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

