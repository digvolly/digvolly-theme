{%- liquid
  assign section_tag = section.settings.tag | default: 'Curated Collections'
  assign section_title = section.settings.title | default: 'Browse by Category'
  assign section_subtitle = section.settings.subtitle | default: 'Find the exact design toolkit you need for your next creative project.'
-%}

<section class="browse-categories-section" aria-label="Browse Digital Asset Categories">
  <div class="homepage-section-container">
    <div class="section-header text-center">
      {%- if section_tag != blank -%}
        <span class="hero-tag">{{ section_tag }}</span>
      {%- endif -%}
      {%- if section_title != blank -%}
        <h2 class="section-title">{{ section_title }}</h2>
      {%- endif -%}
      {%- if section_subtitle != blank -%}
        <p class="section-subtitle">{{ section_subtitle }}</p>
      {%- endif -%}
    </div>

    <div class="category-tiles">
      {%- for i in (1..7) -%}
        {%- liquid
          case i
            when 1
              assign tile_collection = section.settings.tile_1_collection
              assign tile_label = section.settings.tile_1_label | default: 'Patterns'
              assign tile_icon = section.settings.tile_1_icon | default: 'patterns'
              assign tile_url_fallback = '/collections/patterns'
            when 2
              assign tile_collection = section.settings.tile_2_collection
              assign tile_label = section.settings.tile_2_label | default: 'Flyer & Posters'
              assign tile_icon = section.settings.tile_2_icon | default: 'flyer'
              assign tile_url_fallback = '/collections/flyer'
            when 3
              assign tile_collection = section.settings.tile_3_collection
              assign tile_label = section.settings.tile_3_label | default: 'Wedding Invitations'
              assign tile_icon = section.settings.tile_3_icon | default: 'wedding'
              assign tile_url_fallback = '/collections/wedding-invitations'
            when 4
              assign tile_collection = section.settings.tile_4_collection
              assign tile_label = section.settings.tile_4_label | default: 'Menus'
              assign tile_icon = section.settings.tile_4_icon | default: 'menus'
              assign tile_url_fallback = '/collections/menus'
            when 5
              assign tile_collection = section.settings.tile_5_collection
              assign tile_label = section.settings.tile_5_label | default: 'Invoices'
              assign tile_icon = section.settings.tile_5_icon | default: 'invoices'
              assign tile_url_fallback = '/collections/invoices'
            when 6
              assign tile_collection = section.settings.tile_6_collection
              assign tile_label = section.settings.tile_6_label | default: 'Presentation Templates'
              assign tile_icon = section.settings.tile_6_icon | default: 'presentations'
              assign tile_url_fallback = '/collections/presentation-templates'
            when 7
              assign tile_collection = section.settings.tile_7_collection
              assign tile_label = section.settings.tile_7_label | default: 'eBooks & Guides'
              assign tile_icon = section.settings.tile_7_icon | default: 'ebooks'
              assign tile_url_fallback = '/collections/ebooks'
          endcase

          if tile_collection != blank
            assign tile_url = tile_collection.url
            assign tile_count = tile_collection.all_products_count
          else
            assign tile_url = tile_url_fallback
            assign tile_count = 0
          endif
        -%}

        <a href="{{ tile_url }}" class="category-tile" aria-label="Browse {{ tile_label }}">
          <span class="category-tile__icon-wrap">
            {%- case tile_icon -%}
              {%- when 'patterns' -%}
                <svg class="category-tile__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="3" width="7" height="7" rx="1"/>
                  <rect x="14" y="3" width="7" height="7" rx="1"/>
                  <rect x="3" y="14" width="7" height="7" rx="1"/>
                  <rect x="14" y="14" width="7" height="7" rx="1"/>
                </svg>
              {%- when 'flyer' -%}
                <svg class="category-tile__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M21 15V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10"/>
                  <path d="m17 21 4-4"/>
                  <path d="M21 17H17V21"/>
                  <line x1="7" y1="8" x2="17" y2="8"/>
                  <line x1="7" y1="12" x2="13" y2="12"/>
                </svg>
              {%- when 'wedding' -%}
                <svg class="category-tile__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                </svg>
              {%- when 'menus' -%}
                <svg class="category-tile__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/>
                  <path d="M7 2v20"/>
                  <path d="M21 15V2v0a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/>
                </svg>
              {%- when 'invoices' -%}
                <svg class="category-tile__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                  <polyline points="14 2 14 8 20 8"/>
                  <line x1="16" y1="13" x2="8" y2="13"/>
                  <line x1="16" y1="17" x2="8" y2="17"/>
                  <polyline points="10 9 9 9 8 9"/>
                </svg>
              {%- when 'presentations' -%}
                <svg class="category-tile__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M2 3h20"/>
                  <path d="M21 3v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V3"/>
                  <path d="m7 21 5-5 5 5"/>
                </svg>
              {%- when 'ebooks' -%}
                <svg class="category-tile__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
                  <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
                  <line x1="8" y1="7" x2="16" y2="7"/>
                  <line x1="8" y1="11" x2="14" y2="11"/>
                </svg>
            {%- endcase -%}
          </span>
          <span class="category-tile__label">{{ tile_label }}</span>
          {%- if tile_count > 0 -%}
            <span class="category-tile__count">{{ tile_count }} products</span>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

