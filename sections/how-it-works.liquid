<section class="how-it-works-section" aria-label="How Digvolly Works">
  <div class="homepage-section-container">
    <div class="section-header text-center">
      <span class="hero-tag">Simple &amp; Seamless</span>
      <h2 class="section-title">How It Works</h2>
      <p class="section-subtitle">Get production-ready design assets in your creative workflow in four quick steps.</p>
    </div>

    <div class="how-it-works-grid">
      <!-- Step 1 -->
      <div class="how-step-card card glass-panel">
        <div class="how-step-badge">01</div>
        <div class="how-step-icon-wrap">
          <svg class="how-step-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="3" width="7" height="7"></rect>
            <rect x="14" y="3" width="7" height="7"></rect>
            <rect x="14" y="14" width="7" height="7"></rect>
            <rect x="3" y="14" width="7" height="7"></rect>
          </svg>
        </div>
        <h3 class="how-step-title">Browse or Build</h3>
        <p class="how-step-desc">
          Explore our curated catalog of individual packs from $15, or build your own custom 6-asset vault bundle and save 50%.
        </p>
      </div>

      <!-- Step 2 -->
      <div class="how-step-card card glass-panel">
        <div class="how-step-badge">02</div>
        <div class="how-step-icon-wrap">
          <svg class="how-step-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
            <line x1="1" y1="10" x2="23" y2="10"></line>
          </svg>
        </div>
        <h3 class="how-step-title">Instant Checkout</h3>
        <p class="how-step-desc">
          Frictionless 256-bit encrypted checkout via Stripe, PayPal, or Apple Pay. No account creation or password setup required.
        </p>
      </div>

      <!-- Step 3 -->
      <div class="how-step-card card glass-panel">
        <div class="how-step-badge">03</div>
        <div class="how-step-icon-wrap">
          <svg class="how-step-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
        </div>
        <h3 class="how-step-title">Instant Download</h3>
        <p class="how-step-desc">
          One-click ZIP download immediately on your confirmation screen, plus a permanent backup link delivered to your email.
        </p>
      </div>

      <!-- Step 4 -->
      <div class="how-step-card card glass-panel">
        <div class="how-step-badge">04</div>
        <div class="how-step-icon-wrap">
          <svg class="how-step-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            <polyline points="9 12 11 14 15 10"></polyline>
          </svg>
        </div>
        <h3 class="how-step-title">Use Anywhere</h3>
        <p class="how-step-desc">
          Commercial license included on every asset. Create client deliverables, merchandise, apps, and digital products with zero royalties.
        </p>
      </div>
    </div>

    <div class="how-it-works-cta text-center">
      <a href="/pages/build-a-pack" class="button button--primary">
        Build Your 6-Pack & Save 50% &rarr;
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "How It Works",
  "settings": [],
  "presets": [
    {
      "name": "How It Works"
    }
  ]
}
{% endschema %}
