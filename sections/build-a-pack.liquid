<script src="{{ 'build-a-pack.js' | asset_url }}" defer="defer"></script>

{%- assign bundle_product = all_products['custom-6-asset-pack'] -%}
{%- assign bundle_variant = bundle_product.selected_or_first_available_variant -%}
{%- assign bundle_variant_id = bundle_variant.id | default: '55438049608022' -%}

<div class="build-a-pack-wrapper" data-bundle-variant-id="{{ bundle_variant_id }}" aria-label="Build a Custom Pack">
  <!-- Sticky Progress Bar Header (Top of Viewport) -->
  <aside class="pack-sticky-header glass-panel" aria-label="Pack Progress">
    <div class="pack-sticky-header__container">
      <div class="pack-progress-row">
        <div class="pack-counter-box">
          <span class="pack-counter-badge">
            <span class="js-pack-count">0</span> / 6 Selected
          </span>
          <span class="pack-hint-text js-progress-message">Select 6 more assets to unlock 50% bundle savings</span>
        </div>

        <div class="pack-actions-wrap">
          <div class="pack-price-comparison">
            <span class="pack-original-price js-pack-original-val">$0.00 value</span>
            <span class="pack-arrow-sep" aria-hidden="true">→</span>
            <span class="pack-bundle-price js-pack-final-price">$0.00 Pack Price</span>
            <span class="pack-savings-badge js-pack-savings-pill">Save 50%</span>
          </div>

          <!-- Sticky Header Docked Checkout CTA (Desktop) -->
          <button 
            type="button" 
            class="button pack-header-cta js-pack-checkout-btn button--disabled" 
            disabled
            aria-label="Add Pack to Cart"
          >
            <span class="cta-label">Add Pack to Cart — $0.00</span>
          </button>
        </div>
      </div>

      <!-- Visual Progress Bar -->
      <div class="pack-progress-track" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="6">
        <div class="pack-progress-fill js-progress-fill" style="width: 0%;"></div>
      </div>
    </div>
  </aside>

  <!-- Hero Headline & Offer Description -->
  <header class="build-a-pack-hero">
    <div class="hero-tag-wrap">
      <span class="hero-tag">Custom Bundle Builder</span>
    </div>
    <h1 class="build-a-pack-hero__title">Build Your Custom Pack</h1>
    <p class="build-a-pack-hero__subtitle">
      Pick any 6 assets. Save 50% off individual prices.
    </p>

    <!-- Category Filter Tabs -->
    <nav class="pack-filter-pills" role="tablist" aria-label="Filter assets by category">
      <button type="button" class="pack-filter-pill js-pack-filter is-active" data-filter="all" role="tab" aria-selected="true">
        All Assets (<span class="js-pack-tab-count" data-filter="all">86</span>)
      </button>
      <button type="button" class="pack-filter-pill js-pack-filter" data-filter="eBooks" role="tab" aria-selected="false">
        eBooks (<span class="js-pack-tab-count" data-filter="eBooks">1</span>)
      </button>
      <button type="button" class="pack-filter-pill js-pack-filter" data-filter="Presentation Templates" role="tab" aria-selected="false">
        Presentation Templates (<span class="js-pack-tab-count" data-filter="Presentation Templates">23</span>)
      </button>
      <button type="button" class="pack-filter-pill js-pack-filter" data-filter="Patterns" role="tab" aria-selected="false">
        Patterns (<span class="js-pack-tab-count" data-filter="Patterns">62</span>)
      </button>
    </nav>
  </header>

  <!-- Product Selection Grid -->
  <main class="pack-grid-container">
    <h2 class="visually-hidden">Choose Your 6 Assets</h2>
    <div class="pack-items-grid" id="PackItemsGrid">
      {%- paginate collections['all'].products by 250 -%}
      {%- if collections['all'].products != blank and collections['all'].products.size > 0 -%}
        {%- for product in collections['all'].products -%}
          {%- if product.handle == 'custom-6-asset-pack' or product.type == 'Bundle' or product.tags contains 'bundle' or product.tags contains 'internal-bundle' -%}
            {%- continue -%}
          {%- endif -%}
          {%- assign p_title_low = product.title | downcase -%}
          {%- assign p_type_low = product.type | downcase -%}
          {%- assign p_cat = 'Presentation Templates' -%}
          {%- if p_type_low == 'patterns' or p_type_low == 'pattern' -%}
            {%- assign p_cat = 'Patterns' -%}
          {%- elsif p_type_low == 'ebooks' or p_type_low == 'ebook' -%}
            {%- assign p_cat = 'eBooks' -%}
          {%- elsif p_title_low contains 'colouring book' or p_title_low contains 'ebook' or p_title_low contains 'guide' or p_title_low contains 'playbook' -%}
            {%- assign p_cat = 'eBooks' -%}
          {%- elsif p_title_low contains 'pattern' or p_title_low contains 'seamless' or p_title_low contains 'texture' or p_title_low contains 'paper' or p_title_low contains 'repeat' -%}
            {%- assign p_cat = 'Patterns' -%}
          {%- else -%}
            {%- for tag in product.tags -%}
              {%- assign t_low = tag | downcase -%}
              {%- if t_low == 'pattern' or t_low == 'patterns' or t_low == 'seamless' or t_low == 'texture' or t_low == 'paper' -%}
                {%- assign p_cat = 'Patterns' -%}
                {%- break -%}
              {%- elsif t_low == 'ebook' or t_low == 'ebooks' or t_low == 'book' -%}
                {%- assign p_cat = 'eBooks' -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
          {%- if product.price > 0 -%}
            {%- assign card_price = product.price | money -%}
            {%- assign card_price_cents = product.price -%}
          {%- else -%}
            {%- assign mod_idx = forloop.index0 | modulo: 3 -%}
            {%- case p_cat -%}
              {%- when 'eBooks' -%}
                {%- if mod_idx == 0 -%}
                  {%- assign card_price = '$24.00' -%}{%- assign card_price_cents = 2400 -%}
                {%- elsif mod_idx == 1 -%}
                  {%- assign card_price = '$20.00' -%}{%- assign card_price_cents = 2000 -%}
                {%- else -%}
                  {%- assign card_price = '$28.00' -%}{%- assign card_price_cents = 2800 -%}
                {%- endif -%}
              {%- when 'Presentation Templates' -%}
                {%- if mod_idx == 0 -%}
                  {%- assign card_price = '$18.00' -%}{%- assign card_price_cents = 1800 -%}
                {%- elsif mod_idx == 1 -%}
                  {%- assign card_price = '$15.00' -%}{%- assign card_price_cents = 1500 -%}
                {%- else -%}
                  {%- assign card_price = '$22.00' -%}{%- assign card_price_cents = 2200 -%}
                {%- endif -%}
              {%- when 'Patterns' -%}
                {%- if mod_idx == 0 -%}
                  {%- assign card_price = '$8.00' -%}{%- assign card_price_cents = 800 -%}
                {%- elsif mod_idx == 1 -%}
                  {%- assign card_price = '$10.00' -%}{%- assign card_price_cents = 1000 -%}
                {%- else -%}
                  {%- assign card_price = '$12.00' -%}{%- assign card_price_cents = 1200 -%}
                {%- endif -%}
              {%- else -%}
                {%- assign card_price = '$15.00' -%}{%- assign card_price_cents = 1500 -%}
            {%- endcase -%}
          {%- endif -%}
          {% render 'build-a-pack-card',
            product: product,
            id: product.id,
            variant_id: product.selected_or_first_available_variant.id,
            title: product.title,
            category: p_cat,
            price: card_price,
            price_cents: card_price_cents,
            primary_image: product.featured_image,
            secondary_image: product.images[1]
          %}
        {%- endfor -%}
      {%- else -%}
        {% render 'build-a-pack-card',
          id: 'geom-01',
          title: 'Geometric Repeat Pack',
          category: 'Patterns',
          formats: 'AI, EPS, SVG, PNG',
          price: '$10.00',
          price_cents: 1000,
          primary_image: 'mockup-geometric-pack.svg',
          secondary_image: 'mockup-geometric-pack-hover.svg'
        %}

        {% render 'build-a-pack-card',
          id: 'pitch-02',
          title: 'Pitch Deck Pro Template',
          category: 'Presentation Templates',
          formats: 'PPTX, KEY, FIGMA',
          price: '$18.00',
          price_cents: 1800,
          primary_image: 'mockup-pitch-deck.svg',
          secondary_image: 'mockup-pitch-deck-hover.svg'
        %}

        {% render 'build-a-pack-card',
          id: 'paper-03',
          title: 'Watercolor Texture Patterns',
          category: 'Patterns',
          formats: 'JPG 600DPI, PNG',
          price: '$12.00',
          price_cents: 1200,
          primary_image: 'mockup-watercolor-papers.svg',
          secondary_image: 'mockup-watercolor-papers-hover.svg'
        %}

        {% render 'build-a-pack-card',
          id: 'vector-04',
          title: '3D Design Masterclass eBook',
          category: 'eBooks',
          formats: 'PDF, EPUB, NOTION',
          price: '$24.00',
          price_cents: 2400,
          primary_image: 'mockup-vector-graphics.svg',
          secondary_image: 'mockup-vector-graphics-hover.svg'
        %}

        {% render 'build-a-pack-card',
          id: 'brand-05',
          title: 'Brand Identity Starter Kit',
          category: 'Presentation Templates',
          formats: 'AI, EPS, INDD, FIGMA',
          price: '$20.00',
          price_cents: 2000,
          primary_image: 'mockup-branding-kit.svg',
          secondary_image: 'mockup-branding-kit-hover.svg'
        %}

        {% render 'build-a-pack-card',
          id: 'social-06',
          title: 'Social Media Creator Bundle',
          category: 'Presentation Templates',
          formats: 'CANVA, FIGMA, PSD',
          price: '$16.00',
          price_cents: 1600,
          primary_image: 'mockup-social-templates.svg',
          secondary_image: 'mockup-social-templates-hover.svg'
        %}

        {% render 'build-a-pack-card',
          id: 'typo-07',
          title: 'Typography & Layout Handbook eBook',
          category: 'eBooks',
          formats: 'PDF, EPUB, FIGMA',
          price: '$22.00',
          price_cents: 2200,
          primary_image: 'mockup-typography-kit.svg',
          secondary_image: 'mockup-typography-kit-hover.svg'
        %}

        {% render 'build-a-pack-card',
          id: 'ui-08',
          title: 'Mobile UI Design System',
          category: 'Presentation Templates',
          formats: 'FIGMA, SKETCH, XD',
          price: '$28.00',
          price_cents: 2800,
          primary_image: 'mockup-mobile-ui.svg',
          secondary_image: 'mockup-mobile-ui-hover.svg'
        %}

        {% render 'build-a-pack-card',
          id: 'marble-09',
          title: 'Handmade Marble Textures',
          category: 'Patterns',
          formats: 'JPG 6000x4000, TIFF',
          price: '$8.00',
          price_cents: 800,
          primary_image: 'mockup-watercolor-papers-hover.svg',
          secondary_image: 'mockup-watercolor-papers.svg'
        %}

        {% render 'build-a-pack-card',
          id: 'icon-10',
          title: 'Iconography & Design Systems Guide eBook',
          category: 'eBooks',
          formats: 'PDF, EPUB, NOTION',
          price: '$18.00',
          price_cents: 1800,
          primary_image: 'mockup-vector-graphics-hover.svg',
          secondary_image: 'mockup-vector-graphics.svg'
        %}

        {% render 'build-a-pack-card',
          id: 'mag-11',
          title: 'Editorial Magazine Layouts',
          category: 'Presentation Templates',
          formats: 'INDD, IDML, FIGMA',
          price: '$15.00',
          price_cents: 1500,
          primary_image: 'mockup-pitch-deck-hover.svg',
          secondary_image: 'mockup-pitch-deck.svg'
        %}

        {% render 'build-a-pack-card',
          id: 'floral-12',
          title: 'Monoline Floral Patterns',
          category: 'Patterns',
          formats: 'AI, EPS, SVG, PAT',
          price: '$8.00',
          price_cents: 800,
          primary_image: 'mockup-geometric-pack-hover.svg',
          secondary_image: 'mockup-geometric-pack.svg'
        %}
      {%- endif -%}
      {%- endpaginate -%}
    </div>
  </main>

  <!-- Toast Notification when pack is full -->
  <div class="pack-toast-notification js-pack-toast" role="status" aria-live="polite" hidden>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 8px;">
      <circle cx="12" cy="12" r="10"></circle>
      <line x1="12" y1="8" x2="12" y2="12"></line>
      <line x1="12" y1="16" x2="12.01" y2="16"></line>
    </svg>
    <span>Pack full (6/6 selected)! Deselect an item to swap.</span>
  </div>

  <!-- Sticky Bottom Checkout Bar (Mobile & Desktop) -->
  <nav class="pack-bottom-bar glass-panel" aria-label="Pack Checkout Bar">
    <div class="pack-bottom-bar__container">
      <div class="pack-bottom-bar__summary">
        <div class="pack-bottom-bar__count-wrap">
          <strong class="pack-bottom-bar__count"><span class="js-pack-count">0</span> of 6</strong> assets selected
        </div>
        <div class="pack-bottom-bar__price-wrap">
          <span class="pack-bottom-bar__val-struck js-pack-original-val">$0.00 value</span>
          <strong class="pack-bottom-bar__final-price js-pack-final-price">$0.00 Pack Price</strong>
        </div>
      </div>

      <button 
        type="button" 
        class="button pack-bottom-bar__cta js-pack-checkout-btn button--disabled" 
        disabled
        aria-label="Add Pack to Cart"
      >
        <span class="cta-label">Add Pack to Cart — $0.00</span>
      </button>
    </div>
  </nav>
</div>

{% schema %}
{
  "name": "Build a Pack",
  "settings": [],
  "presets": [
    {
      "name": "Build a Pack"
    }
  ]
}
{% endschema %}
