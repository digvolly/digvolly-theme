<script src="{{ 'collection-filters.js' | asset_url }}" defer="defer"></script>

{%- assign current_collection = collection -%}
{%- assign force_category_filter = '' -%}
{%- if collection.handle == 'patterns' and collection.all_products_count == 0 -%}
  {%- assign current_collection = collections['all'] -%}
  {%- assign force_category_filter = 'Patterns' -%}
{%- elsif collection.handle == 'ebooks' and collection.all_products_count == 0 -%}
  {%- assign current_collection = collections['all'] -%}
  {%- assign force_category_filter = 'eBooks' -%}
{%- endif -%}

{%- paginate current_collection.products by 48 -%}
<section class="collection-wrapper" aria-label="Digital Assets Collection">
  <div class="collection-header text-center">
    <span class="hero-tag">Creative Studio Vault</span>
    <h1 class="collection-title">{{ collection.title | default: 'All Creative Digital Assets' }}</h1>
    <p class="collection-desc">
      {%- if collection.description != blank -%}
        {{ collection.description }}
      {%- elsif collection.handle == 'ebooks' -%}
        Comprehensive creator eBooks, actionable typography guides, and design playbooks.
      {%- elsif collection.handle == 'presentation-templates' -%}
        High-converting presentation decks, keynote templates, and multi-format slide toolkits.
      {%- elsif collection.handle == 'patterns' -%}
        Seamless vector patterns, abstract repeats, and handcrafted background packs.
      {%- else -%}
        Explore high-converting presentation templates, comprehensive creator eBooks, and seamless vector pattern packs. Instant commercial licensing on all packs.
      {%- endif -%}
    </p>
  </div>

  <div class="collection-container">
    <h2 class="visually-hidden">{{ collection.title | default: 'Creative Digital Assets' }} Catalog</h2>
    {%- assign visible_products_count = 0 -%}
    {%- for p in current_collection.products -%}
      {%- if p.handle == 'custom-6-asset-pack' or p.tags contains 'internal-bundle' or p.type == 'Bundle' -%}
        {%- continue -%}
      {%- endif -%}
      {%- if force_category_filter == 'Patterns' -%}
        {%- assign p_tl = p.title | downcase -%}
        {%- unless p_tl contains 'pattern' or p_tl contains 'seamless' or p_tl contains 'texture' or p_tl contains 'paper' or p_tl contains 'repeat' or p.tags contains 'pattern' or p.tags contains 'patterns' or p.tags contains 'seamless' -%}
          {%- continue -%}
        {%- endunless -%}
      {%- elsif force_category_filter == 'eBooks' -%}
        {%- assign p_tl = p.title | downcase -%}
        {%- unless p_tl contains 'colouring book' or p_tl contains 'ebook' or p.tags contains 'ebook' or p.tags contains 'book' -%}
          {%- continue -%}
        {%- endunless -%}
      {%- endif -%}
      {%- assign visible_products_count = visible_products_count | plus: 1 -%}
    {%- endfor -%}

    {%- assign total_catalog_count = paginate.items -%}
    {%- if current_collection.handle == 'all' and total_catalog_count > 0 -%}
      {%- assign total_catalog_count = total_catalog_count | minus: 1 -%}
    {%- endif -%}

    {%- if visible_products_count > 0 -%}
      <!-- Filter Sidebar & Toolbar -->
      <div class="collection-toolbar glass-panel">
        <div class="collection-toolbar__left">
          <span class="collection-results-count js-results-count">
            {%- if paginate.pages > 1 and force_category_filter == blank -%}
              Showing {{ paginate.current_offset | plus: 1 }}–{% if paginate.next %}{{ paginate.current_offset | plus: paginate.page_size }}{% else %}{{ total_catalog_count }}{% endif %} of {{ total_catalog_count }} assets
            {%- else -%}
              {{ visible_products_count }} asset{% if visible_products_count != 1 %}s{% endif %} found
            {%- endif -%}
          </span>
          <button type="button" class="clear-filters-btn js-clear-filters" style="display: none;">Clear all filters <span class="js-active-filter-count"></span></button>
        </div>

        <div class="collection-toolbar__right">
          <!-- Compact Mobile Filter Trigger Button (mobile only) -->
          <button type="button" class="mobile-filter-trigger-btn js-open-filter-drawer" aria-label="Open filter options" aria-expanded="false" aria-controls="CollectionSidebarDrawer">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
            </svg>
            <span class="mobile-filter-trigger-label">Filters</span>
            <span class="mobile-filter-badge js-mobile-filter-count" style="display: none;">0</span>
          </button>

          <!-- Grid vs Masonry View Switcher -->
          <div class="view-switcher" role="group" aria-label="Layout view options">
            <button type="button" class="view-btn js-view-grid is-active" title="Grid View" aria-label="Grid View">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="7" height="7"></rect>
                <rect x="14" y="3" width="7" height="7"></rect>
                <rect x="14" y="14" width="7" height="7"></rect>
                <rect x="3" y="14" width="7" height="7"></rect>
              </svg>
              <span>Grid</span>
            </button>
            <button type="button" class="view-btn js-view-masonry" title="Masonry View" aria-label="Masonry View">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="7" height="11"></rect>
                <rect x="14" y="3" width="7" height="6"></rect>
                <rect x="14" y="13" width="7" height="8"></rect>
                <rect x="3" y="17" width="7" height="4"></rect>
              </svg>
              <span>Masonry</span>
            </button>
          </div>
        </div>
      </div>

      <div class="collection-layout">
        <!-- Filter Sidebar / Mobile Bottom Sheet -->
        <aside id="CollectionSidebarDrawer" class="collection-sidebar card glass-panel js-collection-sidebar" aria-label="Filter assets">
          <div class="collection-filter-backdrop js-close-filter-drawer" tabindex="-1" aria-hidden="true"></div>
          <div class="collection-sidebar__inner">
            <!-- Mobile Bottom Sheet Header (hidden on desktop) -->
            <div class="collection-filter-sheet__header">
              <div class="collection-filter-sheet__title-box">
                <div class="collection-filter-sheet__title">Filters</div>
                <span class="collection-filter-sheet__active-pill js-sheet-active-pill" style="display: none;">0 active</span>
              </div>
              <button type="button" class="collection-filter-sheet__close-btn js-close-filter-drawer" aria-label="Close filters">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="18" y1="6" x2="6" y2="18"></line>
                  <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
              </button>
            </div>

            <!-- Filter Accordion Groups (scrollable on mobile) -->
            <div class="collection-filter-sheet__scroll">
              <div class="filter-group js-filter-accordion is-open">
                <button type="button" class="filter-group__header js-filter-accordion-toggle" aria-expanded="true">
                  <span class="filter-group__heading">Asset Category</span>
                  <svg class="filter-group__arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </button>
                <div class="filter-group__content">
                  <label class="filter-checkbox-label">
                    <input type="checkbox" class="js-filter-checkbox" data-group="category" value="eBooks">
                    <span>eBooks</span>
                  </label>
                  <label class="filter-checkbox-label">
                    <input type="checkbox" class="js-filter-checkbox" data-group="category" value="Presentation Templates">
                    <span>Presentation Templates</span>
                  </label>
                  <label class="filter-checkbox-label">
                    <input type="checkbox" class="js-filter-checkbox" data-group="category" value="Patterns">
                    <span>Patterns</span>
                  </label>
                </div>
              </div>
            </div>

            <!-- Mobile Bottom Sheet Sticky Footer (hidden on desktop) -->
            <div class="collection-filter-sheet__footer">
              <button type="button" class="sheet-clear-btn js-clear-filters">Clear All</button>
              <button type="button" class="button button--primary sheet-apply-btn js-close-filter-drawer">
                Apply Filters
              </button>
            </div>
          </div>
        </aside>

        <!-- Products Grid / Masonry Area -->
        <main class="collection-main">
          <div class="products-container products-container--grid js-products-container">
            {%- assign card_idx = 0 -%}
            {%- for product in current_collection.products -%}
              {%- if product.handle == 'custom-6-asset-pack' or product.tags contains 'internal-bundle' or product.type == 'Bundle' -%}
                {%- continue -%}
              {%- endif -%}
              {%- if force_category_filter == 'Patterns' -%}
                {%- assign p_tl = product.title | downcase -%}
                {%- unless p_tl contains 'pattern' or p_tl contains 'seamless' or p_tl contains 'texture' or p_tl contains 'paper' or p_tl contains 'repeat' or product.tags contains 'pattern' or product.tags contains 'patterns' or product.tags contains 'seamless' -%}
                  {%- continue -%}
                {%- endunless -%}
              {%- elsif force_category_filter == 'eBooks' -%}
                {%- assign p_tl = product.title | downcase -%}
                {%- unless p_tl contains 'colouring book' or p_tl contains 'ebook' or product.tags contains 'ebook' or product.tags contains 'book' -%}
                  {%- continue -%}
                {%- endunless -%}
              {%- endif -%}
              {%- assign card_idx = card_idx | plus: 1 -%}
              {%- assign is_lcp_card = false -%}
              {%- if card_idx == 1 -%}
                {%- assign is_lcp_card = true -%}
              {%- endif -%}
              {% render 'product-card', product: product, is_lcp: is_lcp_card %}
            {%- endfor -%}

            <div class="collection-no-results js-no-results" style="display: none;">
              <p class="collection-no-results__title">No assets match the selected filters</p>
              <p class="collection-no-results__desc">Try clearing or adjusting your filter criteria to see more design assets.</p>
              <button type="button" class="button button--secondary js-clear-filters">Clear All Filters</button>
            </div>
          </div>

          {%- if paginate.pages > 1 and force_category_filter == blank -%}
            <nav class="pagination-wrapper" aria-label="Catalog pagination">
              <ul class="pagination-list" role="list">
                {%- if paginate.previous -%}
                  <li class="pagination-item pagination-item--prev">
                    <a href="{{ paginate.previous.url }}" class="pagination-link pagination-link--prev" aria-label="Previous page">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg>
                      <span>Previous</span>
                    </a>
                  </li>
                {%- endif -%}

                {%- for part in paginate.parts -%}
                  {%- if part.is_link -%}
                    <li class="pagination-item">
                      <a href="{{ part.url }}" class="pagination-link" aria-label="Page {{ part.title }}">
                        {{ part.title }}
                      </a>
                    </li>
                  {%- else -%}
                    {%- if part.title == paginate.current_page -%}
                      <li class="pagination-item pagination-item--active">
                        <span class="pagination-link is-active" aria-current="page" aria-label="Page {{ part.title }}, current page">
                          {{ part.title }}
                        </span>
                      </li>
                    {%- else -%}
                      <li class="pagination-item pagination-item--gap">
                        <span class="pagination-ellipsis">{{ part.title }}</span>
                      </li>
                    {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}

                {%- if paginate.next -%}
                  <li class="pagination-item pagination-item--next">
                    <a href="{{ paginate.next.url }}" class="pagination-link pagination-link--next" aria-label="Next page">
                      <span>Next</span>
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
                    </a>
                  </li>
                {%- endif -%}
              </ul>
            </nav>
          {%- endif -%}
        </main>
      </div>
    {%- else -%}
      <!-- Empty Collection / Coming Soon State -->
      <div class="collection-empty card glass-panel">
        <div class="collection-empty__icon-wrap">
          {%- if collection.handle == 'ebooks' -%}
            <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
            </svg>
          {%- elsif collection.handle == 'presentation-templates' -%}
            <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
              <line x1="8" y1="21" x2="16" y2="21"></line>
              <line x1="12" y1="17" x2="12" y2="21"></line>
            </svg>
          {%- else -%}
            <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
              <polyline points="2 17 12 22 22 17"></polyline>
              <polyline points="2 12 12 17 22 12"></polyline>
            </svg>
          {%- endif -%}
        </div>

        <span class="collection-empty__badge">Coming Soon</span>

        <h2 class="collection-empty__title">
          {%- if collection.handle == 'ebooks' -%}
            New eBooks Coming Soon
          {%- elsif collection.handle == 'presentation-templates' -%}
            New Presentation Templates Coming Soon
          {%- else -%}
            New {{ collection.title | default: 'Assets' }} Coming Soon
          {%- endif -%}
        </h2>

        <p class="collection-empty__desc">
          {%- if collection.handle == 'ebooks' -%}
            We are currently curating and formatting brand new comprehensive creator eBooks, design guides, and actionable toolkits. Check back soon or explore our available design asset vault!
          {%- elsif collection.handle == 'presentation-templates' -%}
            High-converting pitch decks, slide frameworks, and keynote presentation templates are currently in final development. Check back soon or explore our available design assets!
          {%- else -%}
            New digital asset packs are currently being prepared for this collection. Browse our full creative catalog in the meantime!
          {%- endif -%}
        </p>

        <div class="collection-empty__actions">
          <a href="{{ routes.all_products_collection_url }}" class="button button--primary collection-empty__btn">
            Browse All Assets
          </a>
          <a href="/pages/build-a-pack" class="button button--secondary collection-empty__btn">
            Build a Custom Pack (Save 50%)
          </a>
        </div>

        <div class="collection-empty__trust-row">
          <div class="cart-trust-item">
            <span class="cart-trust-icon">⚡</span>
            <span>Instant ZIP Downloads</span>
          </div>
          <div class="cart-trust-item">
            <span class="cart-trust-icon">🛡️</span>
            <span>Commercial License Included</span>
          </div>
          <div class="cart-trust-item">
            <span class="cart-trust-icon">🔄</span>
            <span>Lifetime Re-downloads</span>
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>
</section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Collection Main",
  "settings": [],
  "presets": [
    {
      "name": "Collection Main"
    }
  ]
}
{% endschema %}
