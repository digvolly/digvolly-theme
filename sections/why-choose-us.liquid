<section class="why-choose-us-section" aria-label="Why Creators Choose Digvolly">
  <div class="homepage-section-container">
    <div class="section-header text-center">
      <span class="hero-tag">The Digvolly Advantage</span>
      <h2 class="section-title">Why Creators Choose Digvolly</h2>
      <p class="section-subtitle">Premium creative assets crafted for modern designers, founders, and creative studios.</p>
    </div>

    <div class="why-choose-us-grid">
      <!-- Card 1 -->
      <div class="why-card card glass-panel">
        <div class="why-card__icon-wrap">
          <svg class="why-card__icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
            <polyline points="2 17 12 22 22 17"></polyline>
            <polyline points="2 12 12 17 22 12"></polyline>
          </svg>
        </div>
        <h3 class="why-card__title">500+ Design Assets</h3>
        <p class="why-card__desc">
          Handcrafted vector pattern swatches, investor pitch decks, and in-depth design masterclasses built to industry standards.
        </p>
      </div>

      <!-- Card 2 -->
      <div class="why-card card glass-panel">
        <div class="why-card__icon-wrap">
          <svg class="why-card__icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
            <polyline points="10 9 9 9 8 9"></polyline>
          </svg>
        </div>
        <h3 class="why-card__title">Commercial License on Everything</h3>
        <p class="why-card__desc">
          Every asset includes commercial usage rights for client projects, retail packaging, apps, and merchandise with zero royalties.
        </p>
      </div>

      <!-- Card 3 -->
      <div class="why-card card glass-panel">
        <div class="why-card__icon-wrap">
          <svg class="why-card__icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
          </svg>
        </div>
        <h3 class="why-card__title">Instant Digital Delivery</h3>
        <p class="why-card__desc">
          Immediate high-speed ZIP download upon checkout plus an encrypted email backup so you can start creating right away.
        </p>
      </div>

      <!-- Card 4 -->
      <div class="why-card card glass-panel">
        <div class="why-card__icon-wrap">
          <svg class="why-card__icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="23 4 23 10 17 10"></polyline>
            <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
          </svg>
        </div>
        <h3 class="why-card__title">Lifetime Re-downloads</h3>
        <p class="why-card__desc">
          Permanent file preservation with no expiration dates, bandwidth caps, or recurring subscription fees ever.
        </p>
      </div>
    </div>
  </div>
</section>

