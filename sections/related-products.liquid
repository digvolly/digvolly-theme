{%- unless product.handle == 'custom-6-asset-pack' or product.tags contains 'internal-bundle' or product.type == 'Bundle' -%}
<section class="related-products-section js-related-products" aria-label="You may also like">
  <div class="related-products-container">
    <div class="section-header text-center">
      <span class="hero-tag">Curated Recommendations</span>
      <h2 class="section-title">You May Also Like</h2>
      <p class="section-subtitle">Complementary design packs from the same category to level up your creative workflow.</p>
    </div>

    <div class="products-grid js-related-grid">
      {%- liquid
        assign target_collection = nil
        if product != blank
          for c in product.collections
            if c.handle != 'all' and c.handle != 'frontpage' and c.products_count > 1
              assign target_collection = c
              break
            endif
          endfor

          if target_collection == nil
            assign p_type_lower = product.type | downcase
            if p_type_lower contains 'presentation' or p_type_lower contains 'template'
              if collections['presentation-templates'] != blank and collections['presentation-templates'].products_count > 1
                assign target_collection = collections['presentation-templates']
              endif
            elsif p_type_lower contains 'pattern' or p_type_lower contains 'paper'
              if collections['patterns'] != blank and collections['patterns'].products_count > 1
                assign target_collection = collections['patterns']
              endif
            elsif p_type_lower contains 'ebook' or p_type_lower contains 'book'
              if collections['ebooks'] != blank and collections['ebooks'].products_count > 1
                assign target_collection = collections['ebooks']
              endif
            endif
          endif
        endif

        if target_collection == nil or target_collection.products_count < 2
          assign target_collection = collections['all']
        endif

        assign needed_count = 4
        assign rendered_count = 0
        assign rendered_ids = ''

        assign pool_size = target_collection.products.size
        assign start_offset = 0
        if pool_size > 4 and product != blank and product.id != blank
          assign start_offset = product.id | modulo: pool_size
        endif
      -%}

      {%- comment -%} Pass 1: from offset to end of target category collection {%- endcomment -%}
      {%- for rel_product in target_collection.products offset: start_offset -%}
        {%- if rendered_count >= needed_count -%}{%- break -%}{%- endif -%}
        {%- if product != blank and rel_product.id == product.id -%}{%- continue -%}{%- endif -%}
        {%- if product != blank and rel_product.handle == product.handle -%}{%- continue -%}{%- endif -%}
        {%- if rel_product.handle == 'custom-6-asset-pack' or rel_product.tags contains 'internal-bundle' or rel_product.type == 'Bundle' -%}{%- continue -%}{%- endif -%}
        
        {%- assign pid_check = rel_product.id | append: ',' -%}
        {%- if rendered_ids contains pid_check -%}{%- continue -%}{%- endif -%}
        
        {% render 'product-card', product: rel_product %}
        {%- assign rendered_count = rendered_count | plus: 1 -%}
        {%- assign rendered_ids = rendered_ids | append: pid_check -%}
      {%- endfor -%}

      {%- comment -%} Pass 2: from start of target collection up to offset (wrap-around) {%- endcomment -%}
      {%- if rendered_count < needed_count -%}
        {%- for rel_product in target_collection.products -%}
          {%- if rendered_count >= needed_count -%}{%- break -%}{%- endif -%}
          {%- if forloop.index0 >= start_offset -%}{%- break -%}{%- endif -%}
          {%- if product != blank and rel_product.id == product.id -%}{%- continue -%}{%- endif -%}
          {%- if product != blank and rel_product.handle == product.handle -%}{%- continue -%}{%- endif -%}
          {%- if rel_product.handle == 'custom-6-asset-pack' or rel_product.tags contains 'internal-bundle' or rel_product.type == 'Bundle' -%}{%- continue -%}{%- endif -%}
          
          {%- assign pid_check = rel_product.id | append: ',' -%}
          {%- if rendered_ids contains pid_check -%}{%- continue -%}{%- endif -%}
          
          {% render 'product-card', product: rel_product %}
          {%- assign rendered_count = rendered_count | plus: 1 -%}
          {%- assign rendered_ids = rendered_ids | append: pid_check -%}
        {%- endfor -%}
      {%- endif -%}

      {%- comment -%} Pass 3: backfill from collections['all'] if target collection had < 4 items {%- endcomment -%}
      {%- if rendered_count < needed_count and target_collection.handle != 'all' and collections['all'] != blank -%}
        {%- for rel_product in collections['all'].products -%}
          {%- if rendered_count >= needed_count -%}{%- break -%}{%- endif -%}
          {%- if product != blank and rel_product.id == product.id -%}{%- continue -%}{%- endif -%}
          {%- if product != blank and rel_product.handle == product.handle -%}{%- continue -%}{%- endif -%}
          {%- if rel_product.handle == 'custom-6-asset-pack' or rel_product.tags contains 'internal-bundle' or rel_product.type == 'Bundle' -%}{%- continue -%}{%- endif -%}
          
          {%- assign pid_check = rel_product.id | append: ',' -%}
          {%- if rendered_ids contains pid_check -%}{%- continue -%}{%- endif -%}
          
          {% render 'product-card', product: rel_product %}
          {%- assign rendered_count = rendered_count | plus: 1 -%}
          {%- assign rendered_ids = rendered_ids | append: pid_check -%}
        {%- endfor -%}
      {%- endif -%}

      {%- comment -%} Fallback only if store has zero products {%- endcomment -%}
      {%- if rendered_count == 0 -%}
        {% render 'product-card',
          handle: 'watercolor-texture-patterns',
          title: 'Watercolor Texture Patterns',
          price: '$15.00',
          compare_at_price: '$22.00',
          category: 'Patterns',
          badge: 'New',
          formats: 'JPG 600DPI, PNG',
          primary_image: 'mockup-watercolor-papers.svg',
          secondary_image: 'mockup-watercolor-papers-hover.svg',
          url: '/collections/all'
        %}
        {% render 'product-card',
          handle: 'handmade-marble-textures',
          title: 'Handmade Marble Textures',
          price: '$15.00',
          compare_at_price: '$20.00',
          badge: 'Save 25%',
          category: 'Patterns',
          formats: 'JPG 6000x4000, TIFF',
          primary_image: 'mockup-watercolor-papers-hover.svg',
          secondary_image: 'mockup-watercolor-papers.svg',
          url: '/collections/all'
        %}
        {% render 'product-card',
          handle: 'monoline-floral-patterns',
          title: 'Monoline Floral Patterns',
          price: '$15.00',
          compare_at_price: '$22.00',
          badge: 'Save 32%',
          category: 'Patterns',
          formats: 'AI, EPS, SVG, PAT',
          primary_image: 'mockup-geometric-pack-hover.svg',
          secondary_image: 'mockup-geometric-pack.svg',
          url: '/collections/all'
        %}
        {% render 'product-card',
          handle: 'geometric-repeat-pack',
          title: 'Geometric Repeat Pack',
          price: '$15.00',
          compare_at_price: '$25.00',
          badge: 'Save 40%',
          category: 'Patterns',
          formats: 'AI, EPS, SVG, PNG',
          primary_image: 'mockup-geometric-pack.svg',
          secondary_image: 'mockup-geometric-pack-hover.svg',
          url: '/collections/all'
        %}
      {%- endif -%}
    </div>
  </div>
</section>
{%- endunless -%}

{% schema %}
{
  "name": "Related Products",
  "settings": [],
  "presets": [
    {
      "name": "Related Products"
    }
  ]
}
{% endschema %}
