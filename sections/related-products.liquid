<section class="related-products-section" aria-label="You may also like">
  <div class="related-products-container">
    <div class="section-header text-center">
      <span class="hero-tag">Curated Recommendations</span>
      <h2 class="section-title">You May Also Like</h2>
      <p class="section-subtitle">Complementary design packs from our studio to level up your creative workflow.</p>
    </div>

    <div class="products-grid">
      {%- assign rec_collection = collections['all'] -%}
      {%- if rec_collection != blank and rec_collection.products.size > 1 -%}
        {%- assign rendered_count = 0 -%}
        {%- for p in rec_collection.products -%}
          {%- if p.id != product.id and rendered_count < 4 -%}
            {% render 'product-card', product: p %}
            {%- assign rendered_count = rendered_count | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {% render 'product-card',
          title: 'Pitch Deck Pro Template',
          price: '$15.00',
          category: 'Presentation Templates',
          formats: 'PPTX, KEY, FIGMA',
          primary_image: 'mockup-pitch-deck.svg',
          secondary_image: 'mockup-pitch-deck-hover.svg',
          url: routes.all_products_collection_url
        %}

        {% render 'product-card',
          title: 'Watercolor Texture Patterns',
          price: '$15.00',
          category: 'Patterns',
          formats: 'JPG 600DPI, PNG',
          primary_image: 'mockup-watercolor-papers.svg',
          secondary_image: 'mockup-watercolor-papers-hover.svg',
          url: routes.all_products_collection_url
        %}

        {% render 'product-card',
          title: '3D Design Masterclass eBook',
          price: '$15.00',
          category: 'eBooks',
          formats: 'PDF, EPUB, NOTION',
          primary_image: 'mockup-vector-graphics.svg',
          secondary_image: 'mockup-vector-graphics-hover.svg',
          url: routes.all_products_collection_url
        %}

        {% render 'product-card',
          title: 'Brand Identity Starter Kit',
          price: '$15.00',
          category: 'Presentation Templates',
          formats: 'AI, EPS, INDD',
          primary_image: 'mockup-branding-kit.svg',
          secondary_image: 'mockup-branding-kit-hover.svg',
          url: routes.all_products_collection_url
        %}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Related Products",
  "settings": [],
  "presets": [
    {
      "name": "Related Products"
    }
  ]
}
{% endschema %}
