<div class="cart-page-wrapper">
  <div class="cart-page-container">
    {%- if cart.item_count == 0 -%}
      <!-- Empty Cart State -->
      <div class="cart-empty card glass-panel">
        <div class="cart-empty__icon-wrap">
          <svg class="cart-empty__icon" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="9" cy="21" r="1"></circle>
            <circle cx="20" cy="21" r="1"></circle>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
          </svg>
        </div>
        <h1 class="cart-empty__title">Your cart is empty</h1>
        <p class="cart-empty__subtitle">
          Looks like you haven't added any digital assets or bundles to your cart yet. Explore our curated collections or build your own custom 6-pack bundle!
        </p>
        <div class="cart-empty__actions">
          <a href="{{ routes.all_products_collection_url }}" class="button button--primary cart-empty__btn">
            Explore All Assets
          </a>
          <a href="/pages/build-a-pack" class="button button--secondary cart-empty__btn">
            Build a Pack (Save 50%)
          </a>
        </div>

        <div class="cart-empty__trust-row">
          <div class="cart-trust-item">
            <span class="cart-trust-icon">⚡</span>
            <span>Instant ZIP Download</span>
          </div>
          <div class="cart-trust-item">
            <span class="cart-trust-icon">📄</span>
            <span>Commercial License Included</span>
          </div>
          <div class="cart-trust-item">
            <span class="cart-trust-icon">🔒</span>
            <span>256-Bit SSL Checkout</span>
          </div>
        </div>
      </div>

    {%- else -%}
      <!-- Active Cart State -->
      <header class="cart-header">
        <div class="cart-header__title-wrap">
          <h1 class="cart-header__title">Shopping Cart</h1>
          <span class="cart-header__badge">{{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %}</span>
        </div>
        <div class="cart-header__trust-pill">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px;" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          Instant Download &bull; Commercial License Included
        </div>
      </header>

      {% render 'cart-bogo-message' %}

      <div class="cart-layout-grid">
        <!-- Main Cart Items Column -->
        <main class="cart-items-column">
          <form action="{{ routes.cart_url }}" method="post" id="cart-form" class="cart-form card glass-panel">
            <div class="cart-table-head">
              <span class="cart-th-asset" style="grid-column: span 2;">Digital Asset</span>
              <span class="cart-th-price">Price</span>
              <span class="cart-th-qty">Quantity</span>
              <span class="cart-th-total" style="text-align: right;">Total</span>
            </div>

            <div class="cart-items-list">
              {%- for item in cart.items -%}
                {%- assign is_bundle = false -%}
                {%- if item.product.handle == 'custom-6-asset-pack' or item.product.title contains 'Custom 6-Asset Pack' or item.handle == 'custom-6-asset-pack' or item.title contains 'Custom 6-Asset Pack' -%}
                  {%- assign is_bundle = true -%}
                {%- endif -%}
                {%- if item.product.tags contains 'internal-bundle' or item.product.type == 'Bundle' -%}
                  {%- assign is_bundle = true -%}
                {%- endif -%}
                {%- if item.properties['_PackType'] != blank -%}
                  {%- assign is_bundle = true -%}
                {%- endif -%}
                <article class="cart-item js-cart-item" data-key="{{ item.key }}" data-line="{{ forloop.index }}" data-eligible="{% if is_bundle %}false{% else %}true{% endif %}" data-quantity="{{ item.quantity }}">
                  <!-- Item Thumbnail -->
                  <a href="{{ item.url }}" class="cart-item__thumb-link" aria-label="View {{ item.product.title | escape }}">
                    {%- if item.image != blank -%}
                      <img 
                        src="{{ item.image | image_url: width: 220, height: 160, crop: 'center', format: 'webp' }}" 
                        alt="{{ item.product.title | default: item.title | escape }} — {{ item.product.type | default: 'digital asset' }} in cart" 
                        class="cart-item__thumb-img"
                        width="110" 
                        height="80" 
                        loading="lazy"
                        decoding="async"
                      >
                    {%- else -%}
                      <img 
                        src="{{ 'mockup-geometric-pack.svg' | asset_url }}" 
                        alt="{{ item.product.title | default: item.title | escape }} — {{ item.product.type | default: 'digital asset' }} in cart" 
                        class="cart-item__thumb-img"
                        width="110" 
                        height="80" 
                        loading="lazy"
                      >
                    {%- endif -%}
                  </a>

                  <!-- Item Information -->
                  <div class="cart-item__info">
                    <div class="cart-item__meta-top">
                      {%- if item.product.type != blank -%}
                        <span class="cart-item__category-badge">{{ item.product.type }}</span>
                      {%- endif -%}
                      
                      {%- if item.properties['_PackType'] != blank -%}
                        <span class="cart-item__pack-badge">
                          {{ item.properties['_PackType'] }}
                        </span>
                      {%- endif -%}
                    </div>

                    <h2 class="cart-item__title">
                      <a href="{{ item.url }}">{{ item.product.title }}</a>
                    </h2>

                    {%- unless item.product.has_only_default_variant -%}
                      <p class="cart-item__variant">{{ item.variant.title }}</p>
                    {%- endunless -%}

                    <div class="cart-item__license-tag">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="20 6 9 17 4 12"></polyline>
                      </svg>
                      <span>Commercial License &bull; Instant ZIP</span>
                    </div>

                    <!-- Additional Properties -->
                    {%- for property in item.properties -%}
                      {%- assign p_first_char = property.first | slice: 0 -%}
                      {%- if property.last != blank and p_first_char != '_' -%}
                        <div class="cart-item__custom-prop">
                          <strong>{{ property.first }}:</strong> {{ property.last }}
                        </div>
                      {%- endif -%}
                    {%- endfor -%}

                    {%- if item.line_level_discount_allocations.size > 0 -%}
                      <ul class="cart-item__discounts" style="list-style: none; padding: 0; margin: 6px 0 0; font-size: 13px; color: #059669; font-weight: 600;">
                        {%- for discount_allocation in item.line_level_discount_allocations -%}
                          <li class="cart-item__discount">
                            🎉 {{ discount_allocation.discount_application.title }}: -{{ discount_allocation.amount | money }}
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}

                    <!-- Mobile-Only Price & Subtotal -->
                    <div class="cart-item__mobile-price-row">
                      <span class="cart-item__mobile-unit">
                        {{ item.final_price | money }}
                        {%- if item.original_price != item.final_price -%}
                          <s class="cart-item__compare-price" style="margin-left: 6px; font-size: 13px; color: #9CA3AF;">{{ item.original_price | money }}</s>
                        {%- endif -%}
                      </span>
                    </div>
                  </div>

                  <!-- Item Unit Price (Desktop) -->
                  <div class="cart-item__unit-price">
                    <span class="cart-item__price-val">{{ item.final_price | money }}</span>
                    {%- if item.original_price != item.final_price -%}
                      <s class="cart-item__compare-price">{{ item.original_price | money }}</s>
                    {%- endif -%}
                  </div>

                  <!-- Item Quantity Adjusters -->
                  <div class="cart-item__quantity">
                    <div class="cart-qty-stepper">
                      <button 
                        type="button" 
                        class="cart-qty-btn cart-qty-btn--minus js-cart-qty-btn" 
                        data-key="{{ item.key }}" 
                        data-delta="-1" 
                        aria-label="Decrease quantity of {{ item.title | escape }}"
                      >&minus;</button>
                      <input 
                        type="number" 
                        name="updates[]" 
                        value="{{ item.quantity }}" 
                        min="0" 
                        id="updates_{{ item.key }}" 
                        class="cart-qty-input js-cart-qty-input" 
                        data-key="{{ item.key }}"
                        aria-label="Quantity of {{ item.title | escape }}"
                      >
                      <button 
                        type="button" 
                        class="cart-qty-btn cart-qty-btn--plus js-cart-qty-btn" 
                        data-key="{{ item.key }}" 
                        data-delta="1" 
                        aria-label="Increase quantity of {{ item.title | escape }}"
                      >&plus;</button>
                    </div>

                    <button 
                      type="button" 
                      class="cart-item__remove-btn js-cart-remove" 
                      data-key="{{ item.key }}" 
                      aria-label="Remove {{ item.title | escape }}"
                    >
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="vertical-align: -2px; margin-right: 4px;">
                        <polyline points="3 6 5 6 21 6"></polyline>
                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                      </svg>
                      Remove
                    </button>
                  </div>

                  <!-- Item Line Total Price -->
                  <div class="cart-item__line-total">
                    <strong class="cart-item__total-val js-cart-line-total">{{ item.final_line_price | money }}</strong>
                    {%- if item.original_line_price != item.final_line_price -%}
                      <s class="cart-item__compare-price" style="display: block; font-size: 13px; color: #9CA3AF;">{{ item.original_line_price | money }}</s>
                    {%- endif -%}
                  </div>
                </article>
              {%- endfor -%}
            </div>

            <!-- Footer Actions inside items list -->
            <div class="cart-items-actions">
              <a href="{{ routes.all_products_collection_url }}" class="cart-back-link">
                &larr; Continue Shopping
              </a>
              <button type="button" class="cart-clear-btn js-clear-cart">
                Clear Cart
              </button>
            </div>
          </form>

          <!-- Digital Guarantee Block Below Items -->
          <aside class="cart-guarantee card glass-panel" aria-label="Customer Guarantee">
            <div class="cart-guarantee__grid">
              <div class="cart-guarantee__item">
                <div class="cart-guarantee__icon">⚡</div>
                <div class="cart-guarantee__text">
                  <strong>Instant Download</strong>
                  <span>Direct download links provided immediately after payment, plus lifetime backup links sent to your email.</span>
                </div>
              </div>
              <div class="cart-guarantee__item">
                <div class="cart-guarantee__icon">📜</div>
                <div class="cart-guarantee__text">
                  <strong>Commercial License</strong>
                  <span>Every asset includes our full commercial license: unlimited client work, apps, web, print & digital end products.</span>
                </div>
              </div>
              <div class="cart-guarantee__item">
                <div class="cart-guarantee__icon">🛡️</div>
                <div class="cart-guarantee__text">
                  <strong>100% Quality Verified</strong>
                  <span>High-resolution master vector and bitmap files created by professional digital designers.</span>
                </div>
              </div>
            </div>
          </aside>
        </main>

        <!-- Order Summary Sidebar Column -->
        <aside class="cart-summary-column">
          <div class="cart-summary card glass-panel">
            <h2 class="cart-summary__title">Order Summary</h2>

            <div class="cart-summary__row">
              <span class="cart-summary__label">Subtotal ({{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %})</span>
              <span class="cart-summary__value js-cart-subtotal">
                {%- if cart.total_discount > 0 -%}
                  {{ cart.original_total_price | money }}
                {%- else -%}
                  {{ cart.total_price | money }}
                {%- endif -%}
              </span>
            </div>

            <div class="cart-summary__row">
              <span class="cart-summary__label">Digital Delivery</span>
              <span class="cart-summary__value cart-summary__value--free">FREE (Instant)</span>
            </div>

            <div class="cart-summary__row">
              <span class="cart-summary__label">Taxes</span>
              <span class="cart-summary__value cart-summary__value--muted">Calculated at checkout</span>
            </div>

            {%- if cart.cart_level_discount_applications.size > 0 -%}
              <div class="cart-summary__discounts">
                {%- for discount in cart.cart_level_discount_applications -%}
                  <div class="cart-summary__row cart-summary__discount-row">
                    <span class="cart-summary__label">🎉 {{ discount.title }}</span>
                    <span class="cart-summary__value" style="color: #059669; font-weight: 700;">-{{ discount.total_allocated_amount | money }}</span>
                  </div>
                {%- endfor -%}
              </div>
            {%- elsif cart.total_discount > 0 -%}
              <div class="cart-summary__discounts">
                <div class="cart-summary__row cart-summary__discount-row">
                  <span class="cart-summary__label">🎉 Total Savings</span>
                  <span class="cart-summary__value" style="color: #059669; font-weight: 700;">-{{ cart.total_discount | money }}</span>
                </div>
              </div>
            {%- endif -%}

            <div class="cart-summary__divider"></div>

            <div class="cart-summary__row cart-summary__row--total">
              <span class="cart-summary__total-label">Estimated Total</span>
              <strong class="cart-summary__total-val js-cart-total">{{ cart.total_price | money }}</strong>
            </div>

            <!-- Proceed to Checkout Button -->
            <button 
              type="submit" 
              name="checkout" 
              form="cart-form" 
              class="button button--primary cart-summary__checkout-btn js-cart-checkout-btn"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 8px; vertical-align: -3px;" aria-hidden="true">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
              Proceed to Checkout
            </button>

            <!-- Payment Badges & SSL Callout -->
            <div class="cart-summary__trust-footer">
              <div class="cart-summary__security-badge">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                </svg>
                <span>256-Bit SSL Encrypted Checkout</span>
              </div>
              <p class="cart-summary__payment-note">
                Immediate file access after payment confirmation.
              </p>
            </div>
          </div>
        </aside>
      </div>
    {%- endif -%}
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // AJAX Quantity Updaters
  const cartForm = document.getElementById('cart-form');
  if (!cartForm) return;

  async function updateQuantity(key, newQty) {
    try {
      const response = await fetch('/cart/change.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({
          id: key,
          quantity: Math.max(0, parseInt(newQty, 10))
        })
      });

      if (response.ok) {
        window.location.reload();
      } else {
        const data = await response.json();
        alert(data.message || 'Error updating cart');
      }
    } catch (err) {
      console.error('Failed to update cart', err);
      window.location.reload();
    }
  }

  // Handle Stepper Buttons
  document.querySelectorAll('.js-cart-qty-btn').forEach(btn => {
    btn.addEventListener('click', function() {
      const key = this.dataset.key;
      const delta = parseInt(this.dataset.delta, 10);
      const input = document.getElementById('updates_' + key);
      if (!input) return;
      const currentQty = parseInt(input.value, 10) || 1;
      const nextQty = Math.max(0, currentQty + delta);
      input.value = nextQty;
      updateQuantity(key, nextQty);
    });
  });

  // Handle direct input blur / change
  document.querySelectorAll('.js-cart-qty-input').forEach(input => {
    input.addEventListener('change', function() {
      const key = this.dataset.key;
      const val = parseInt(this.value, 10);
      if (!isNaN(val)) {
        updateQuantity(key, val);
      }
    });
  });

  // Handle Remove Button
  document.querySelectorAll('.js-cart-remove').forEach(btn => {
    btn.addEventListener('click', function(e) {
      e.preventDefault();
      const key = this.dataset.key;
      updateQuantity(key, 0);
    });
  });

  // Handle Clear Cart Button
  const clearBtn = document.querySelector('.js-clear-cart');
  if (clearBtn) {
    clearBtn.addEventListener('click', async function() {
      if (!confirm('Are you sure you want to remove all items from your cart?')) return;
      try {
        await fetch('/cart/clear.js', { method: 'POST' });
        window.location.reload();
      } catch (err) {
        console.error('Clear cart error', err);
        window.location.reload();
      }
    });
  }
  // Client-side helper for dynamic BOGO banner update
  function updateBogoBanner() {
    const banner = document.querySelector('.js-cart-bogo-banner');
    if (!banner) return;
    
    let eligibleCount = 0;
    document.querySelectorAll('.js-cart-item').forEach(item => {
      const isEligible = item.dataset.eligible !== 'false';
      const qtyInput = item.querySelector('.js-cart-qty-input');
      const qty = qtyInput ? (parseInt(qtyInput.value, 10) || 0) : (parseInt(item.dataset.quantity, 10) || 0);
      if (isEligible) {
        eligibleCount += qty;
      }
    });

    const msg1 = banner.dataset.msg1 || "Add 4 more templates — they're FREE! Browse the collection";
    const msgRange = banner.dataset.msgRange || "Add {N} more to get all 4 FREE";
    const msg5 = banner.dataset.msg5 || "Congratulations! You got 4 FREE templates 🎉";
    const msgEl = banner.querySelector('.js-bogo-message');
    const actionsEl = banner.querySelector('.js-bogo-actions');
    const progressFill = banner.querySelector('.js-bogo-progress-fill');
    const iconEl = banner.querySelector('.cart-bogo-banner__icon');
    const pillEl = banner.querySelector('.cart-bogo-banner__pill');
    const steps = banner.querySelectorAll('.cart-bogo-banner__progress-step');

    if (eligibleCount <= 0) {
      banner.style.display = 'none';
      return;
    }

    banner.style.display = '';
    const remaining = Math.max(0, 5 - eligibleCount);
    const progressPercent = Math.min(100, (eligibleCount / 5) * 100);

    if (progressFill) progressFill.style.width = progressPercent + '%';

    if (steps) {
      steps.forEach((step, idx) => {
        if (eligibleCount >= idx + 1) {
          step.classList.add('is-reached');
        } else {
          step.classList.remove('is-reached');
        }
      });
    }

    if (eligibleCount === 1) {
      banner.classList.remove('is-unlocked');
      banner.classList.add('is-active');
      if (msgEl) msgEl.textContent = msg1;
      if (actionsEl) actionsEl.style.display = '';
      if (iconEl) iconEl.textContent = '🎁';
      if (pillEl) pillEl.textContent = 'Buy 1 Get 4 FREE Deal';
    } else if (eligibleCount >= 2 && eligibleCount <= 4) {
      banner.classList.remove('is-unlocked');
      banner.classList.add('is-active');
      if (msgEl) msgEl.textContent = msgRange.replace('{N}', remaining);
      if (actionsEl) actionsEl.style.display = 'none';
      if (iconEl) iconEl.textContent = '🎁';
      if (pillEl) pillEl.textContent = 'Buy 1 Get 4 FREE Deal';
    } else if (eligibleCount >= 5) {
      banner.classList.remove('is-active');
      banner.classList.add('is-unlocked');
      if (msgEl) msgEl.textContent = msg5;
      if (actionsEl) actionsEl.style.display = 'none';
      if (iconEl) iconEl.textContent = '🎉';
      if (pillEl) pillEl.textContent = 'Special Offer Applied';
    }
  }

  window.updateBogoCartBanner = updateBogoBanner;
});
</script>

{% schema %}
{
  "name": "Shopping Cart",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_bogo_message",
      "label": "Show Buy 1 Get 4 Free promotion banner",
      "default": true
    },
    {
      "type": "text",
      "id": "bogo_msg_1",
      "label": "1 eligible item message",
      "default": "Add 4 more templates — they're FREE! Browse the collection"
    },
    {
      "type": "text",
      "id": "bogo_btn_text",
      "label": "Button text for 1 eligible item",
      "default": "Browse the collection"
    },
    {
      "type": "url",
      "id": "bogo_btn_url",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "bogo_msg_range",
      "label": "2 to 4 eligible items message ({N} = remaining count)",
      "default": "Add {N} more to get all 4 FREE"
    },
    {
      "type": "text",
      "id": "bogo_msg_5",
      "label": "5+ eligible items message",
      "default": "Congratulations! You got 4 FREE templates 🎉"
    }
  ],
  "presets": [
    {
      "name": "Shopping Cart"
    }
  ]
}
{% endschema %}
