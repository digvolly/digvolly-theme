<header class="header-wrapper glass-panel">
  <div class="header__heading-container">
    <a href="{{ routes.root_url }}" class="header__heading">
      Digvolly
    </a>
  </div>
  <nav class="nav-links" aria-label="Main Navigation">
    <a href="{{ routes.root_url }}">Home</a>
    <a href="/pages/build-a-pack" class="nav-link-badge">
      Build a Pack
      <span class="nav-badge-pill">Save 83%</span>
    </a>
    <a href="/pages/bundle">Curated Bundles</a>
    <a href="{{ routes.collections_url }}/patterns">Patterns</a>
    <a href="{{ routes.collections_url }}/templates">Templates</a>
    <a href="/pages/contact">Contact</a>
    <a href="{{ routes.cart_url }}" class="cart-link" aria-label="Cart">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="9" cy="21" r="1"></circle>
        <circle cx="20" cy="21" r="1"></circle>
        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
      </svg>
      <span class="cart-counter" aria-hidden="true">{{ cart.item_count }}</span>
    </a>
  </nav>
</header>

{% schema %}
{
  "name": "Header",
  "settings": []
}
{% endschema %}
