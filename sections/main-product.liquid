<script src="{{ 'product-gallery.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign current_product = product
  assign p_title = current_product.title | default: 'Geometric Repeat Pack'
  assign p_handle = current_product.handle | default: 'geometric-repeat-pack'
  assign p_price = '$15.00'
  if current_product != blank and current_product.price > 0
    assign p_price = current_product.price | money
  endif
  assign p_compare = '$25.00'
  if current_product != blank and current_product.compare_at_price > current_product.price
    assign p_compare = current_product.compare_at_price | money
  endif
  assign p_desc = current_product.description | default: 'A comprehensive collection of 24 handcrafted, seamless vector geometric pattern repeats. Perfect for textile design, editorial packaging, branding identity, web backgrounds, and modern print media. Fully editable vector layers in AI and EPS formats.'
  assign p_cat = 'Patterns'
  if current_product.type != blank
    assign raw_cat = current_product.type | downcase
    if raw_cat contains 'ebook' or raw_cat contains 'book'
      assign p_cat = 'eBooks'
    elsif raw_cat contains 'presentation' or raw_cat contains 'template'
      assign p_cat = 'Presentation Templates'
    endif
  endif
  assign image_count = current_product.images.size
  if current_product == blank or current_product.images.size == 0
    assign image_count = 4
  endif
-%}

{%- if current_product.handle == 'custom-6-asset-pack' or current_product.tags contains 'internal-bundle' or current_product.type == 'Bundle' -%}
  <section class="main-product-section text-center" style="padding: 100px 20px;">
    <div class="card glass-panel" style="max-width: 580px; margin: 0 auto; padding: 48px 32px; border-radius: 16px;">
      <span class="hero-tag" style="margin-bottom: 16px; display: inline-block;">Custom Pack Builder</span>
      <h1 style="font-size: 28px; font-weight: 800; color: #111827; margin: 16px 0 12px;">Custom Packs Must Be Built Interactively</h1>
      <p style="font-size: 16px; color: #4B5563; line-height: 1.6; margin-bottom: 28px;">
        The Custom 6-Asset Pack cannot be purchased directly without selecting your 6 digital assets. Please use our interactive pack builder to choose your assets and receive your $29 bundle pricing.
      </p>
      <a href="/pages/build-a-pack" class="button button--primary" style="padding: 14px 28px; font-size: 15px; font-weight: 600; text-decoration: none;">
        Launch Build a Pack Builder &rarr;
      </a>
    </div>
    <script>
      window.location.replace('/pages/build-a-pack');
    </script>
    <meta http-equiv="refresh" content="0; url=/pages/build-a-pack">
  </section>
{%- else -%}
<section class="main-product-section js-main-product" data-current-handle="{{ p_handle }}" aria-label="{{ p_title }}">
  <div class="product-page-container">
    <div class="product-layout-grid">
      
      <!-- Left Column: Multi-Image Slide / Pattern Gallery -->
      <div class="product-gallery-column js-product-gallery">
        <!-- Desktop Main Large Preview & Mobile Swipeable Slides -->
        <div class="product-gallery-main card">
          <div class="product-gallery-slides js-gallery-slides" role="region" aria-label="Product Image Carousel">
            {%- if current_product.images.size > 0 -%}
              {%- for image in current_product.images -%}
                <div class="gallery-slide {% if forloop.first %}is-active{% endif %}" data-index="{{ forloop.index0 }}">
                  <img 
                    src="{{ image | image_url: width: 700, format: 'webp' }}" 
                    srcset="{{ image | image_url: width: 380, format: 'webp' }} 380w,
                            {{ image | image_url: width: 550, format: 'webp' }} 550w,
                            {{ image | image_url: width: 700, format: 'webp' }} 700w,
                            {{ image | image_url: width: 1000, format: 'webp' }} 1000w"
                    sizes="(max-width: 640px) 92vw, (max-width: 1024px) 48vw, 600px"
                    alt="{{ p_title }} — {{ p_cat | default: 'digital design asset' }} slide preview {{ forloop.index }}" 
                    class="{% if forloop.first %}product-gallery-main__img js-gallery-main-img{% else %}gallery-slide__img{% endif %}"
                    width="600" 
                    height="400"
                    loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                    {% if forloop.first %}fetchpriority="high"{% endif %}
                    decoding="async"
                  >
                </div>
              {%- endfor -%}
            {%- else -%}
              <div class="gallery-slide is-active" data-index="0">
                <img 
                  src="{{ 'mockup-geometric-pack.svg' | asset_url }}" 
                  alt="{{ p_title }} — {{ p_cat | default: 'digital design asset' }} slide preview 1" 
                  class="product-gallery-main__img js-gallery-main-img"
                  width="600" 
                  height="400" 
                  loading="eager"
                >
              </div>
              <div class="gallery-slide" data-index="1">
                <img 
                  src="{{ 'mockup-geometric-pack-hover.svg' | asset_url }}" 
                  alt="{{ p_title }} — {{ p_cat | default: 'digital design asset' }} slide preview 2" 
                  class="gallery-slide__img"
                  width="600" 
                  height="400" 
                  loading="lazy"
                >
              </div>
              <div class="gallery-slide" data-index="2">
                <img 
                  src="{{ 'mockup-pitch-deck.svg' | asset_url }}" 
                  alt="{{ p_title }} — {{ p_cat | default: 'digital design asset' }} slide preview 3" 
                  class="gallery-slide__img"
                  width="600" 
                  height="400" 
                  loading="lazy"
                >
              </div>
              <div class="gallery-slide" data-index="3">
                <img 
                  src="{{ 'mockup-watercolor-papers.svg' | asset_url }}" 
                  alt="{{ p_title }} — {{ p_cat | default: 'digital design asset' }} slide preview 4" 
                  class="gallery-slide__img"
                  width="600" 
                  height="400" 
                  loading="lazy"
                >
              </div>
            {%- endif -%}
          </div>

          <!-- Magnifying Glass Zoom Trigger Hint -->
          <button type="button" class="product-gallery-zoom-trigger js-gallery-zoom-trigger" aria-label="Zoom product image" title="Click to enlarge">
            <svg class="zoom-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              <line x1="11" y1="8" x2="11" y2="14"></line>
              <line x1="8" y1="11" x2="14" y2="11"></line>
            </svg>
            <span class="zoom-label">Click to zoom</span>
          </button>

          <!-- Gallery Navigation Arrows (Only rendered when 2+ images) -->
          {%- if image_count > 1 -%}
            <button type="button" class="gallery-arrow gallery-arrow--prev js-gallery-arrow-prev" aria-label="Previous image">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
            </button>
            <button type="button" class="gallery-arrow gallery-arrow--next js-gallery-arrow-next" aria-label="Next image">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </button>
          {%- endif -%}

          <div class="product-gallery-badge">High-Res Master Preview</div>
        </div>

        <!-- Mobile Carousel Dots Indicator (Only rendered when 2+ images) -->
        {%- if image_count > 1 -%}
          <div class="gallery-dots js-gallery-dots" role="tablist" aria-label="Carousel pagination">
            {%- if current_product.images.size > 0 -%}
              {%- for image in current_product.images -%}
                <button type="button" class="gallery-dot {% if forloop.first %}is-active{% endif %}" data-index="{{ forloop.index0 }}" aria-label="Slide {{ forloop.index }}"></button>
              {%- endfor -%}
            {%- else -%}
              <button type="button" class="gallery-dot is-active" data-index="0" aria-label="Slide 1"></button>
              <button type="button" class="gallery-dot" data-index="1" aria-label="Slide 2"></button>
              <button type="button" class="gallery-dot" data-index="2" aria-label="Slide 3"></button>
              <button type="button" class="gallery-dot" data-index="3" aria-label="Slide 4"></button>
            {%- endif -%}
          </div>
        {%- endif -%}

        <!-- Thumbnail Carousel Strip (Desktop & Tablet - Only rendered when 2+ images) -->
        {%- if image_count > 1 -%}
          <div class="product-gallery-thumbs js-gallery-thumbs" role="tablist" aria-label="Product thumbnail variations">
            {%- if current_product.images.size > 0 -%}
              {%- for image in current_product.images -%}
                <button type="button" class="gallery-thumb js-gallery-thumb {% if forloop.first %}is-active{% endif %}" data-index="{{ forloop.index0 }}" data-full-src="{{ image | image_url: width: 1200, format: 'webp' }}" data-alt="View {{ forloop.index }}">
                  <img src="{{ image | image_url: width: 140, height: 100, crop: 'center', format: 'webp' }}" alt="{{ p_title }} — thumbnail {{ forloop.index }}" width="100" height="70" loading="lazy" decoding="async">
                </button>
              {%- endfor -%}
            {%- else -%}
              <button type="button" class="gallery-thumb js-gallery-thumb is-active" data-index="0" data-full-src="{{ 'mockup-geometric-pack.svg' | asset_url }}" data-alt="Cover View">
                <img src="{{ 'mockup-geometric-pack.svg' | asset_url }}" alt="{{ p_title }} — thumbnail 1" width="100" height="70" loading="lazy">
              </button>
              <button type="button" class="gallery-thumb js-gallery-thumb" data-index="1" data-full-src="{{ 'mockup-geometric-pack-hover.svg' | asset_url }}" data-alt="Slide 2: Pattern Inverted Detail">
                <img src="{{ 'mockup-geometric-pack-hover.svg' | asset_url }}" alt="{{ p_title }} — thumbnail 2" width="100" height="70" loading="lazy">
              </button>
              <button type="button" class="gallery-thumb js-gallery-thumb" data-index="2" data-full-src="{{ 'mockup-pitch-deck.svg' | asset_url }}" data-alt="Slide 3: Layout Specs">
                <img src="{{ 'mockup-pitch-deck.svg' | asset_url }}" alt="{{ p_title }} — thumbnail 3" width="100" height="70" loading="lazy">
              </button>
              <button type="button" class="gallery-thumb js-gallery-thumb" data-index="3" data-full-src="{{ 'mockup-watercolor-papers.svg' | asset_url }}" data-alt="Slide 4: Swatch Zoom">
                <img src="{{ 'mockup-watercolor-papers.svg' | asset_url }}" alt="{{ p_title }} — thumbnail 4" width="100" height="70" loading="lazy">
              </button>
            {%- endif -%}
          </div>
        {%- endif -%}

        <!-- Trust Block: 4-Badge Grid + Full Commercial License Banner directly under thumbnails -->
        <div class="product-trust-section">
          {% render 'trust-badges' %}
          {% render 'commercial-license-badge' %}
        </div>

        <!-- Mobile-Only In-Page Add to Cart Action: Sits directly BELOW the trust block on mobile -->
        <div class="product-mobile-atc-wrap">
          <form method="post" action="{{ routes.cart_add_url }}" class="product-form js-add-to-cart-form" enctype="multipart/form-data">
            <input type="hidden" name="id" class="js-product-variant-id" value="{{ current_product.selected_or_first_available_variant.id | default: '45000000001' }}">
            <input type="hidden" name="quantity" value="1">

            <div class="product-form__actions">
              <button type="submit" name="add" class="button button--primary product-add-btn js-add-to-cart-btn" aria-label="Add {{ p_title }} to cart">
                <span class="btn-text js-btn-text">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: -3px; margin-right: 6px;" aria-hidden="true">
                    <circle cx="9" cy="21" r="1"></circle>
                    <circle cx="20" cy="21" r="1"></circle>
                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                  </svg>
                  Add to Cart &bull; <span class="js-btn-price-display">{{ p_price }}</span>
                </span>
                <span class="btn-loading js-btn-loading" style="display: none;">
                  <svg class="spinner-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21 12a9 9 0 1 1-6.219-8.56"></path>
                  </svg>
                  Adding to Cart...
                </span>
              </button>
            </div>
          </form>
        </div>
      </div>

      <!-- Right Column: Product Details & Purchase Box -->
      <div class="product-info-column">
        <div class="product-buy-box card glass-panel js-product-buy-box">
          
          <!-- Category Badge on its own line -->
          <div class="product-info__badge-wrap">
            <span class="product-info__category-badge js-product-category">{{ p_cat }}</span>
          </div>

          <!-- Breadcrumb Navigation on its own line -->
          <nav class="product-breadcrumbs" aria-label="Breadcrumb">
            <a href="{{ routes.root_url }}">Home</a> &rsaquo; 
            <a href="{{ routes.all_products_collection_url }}" class="js-breadcrumb-cat">{{ p_cat }}</a> &rsaquo;
            <span class="js-breadcrumb-title">{{ p_title }}</span>
          </nav>

          <!-- Product Title -->
          <h1 class="product-info__title js-product-title">{{ p_title }}</h1>
          
          <!-- Price & Savings Row -->
          <div class="product-info__price-box">
            <div class="product-info__price-row">
              <span class="product-info__price js-product-price">{{ p_price }}</span>
              <s class="product-info__compare-price js-product-compare-price">{{ p_compare }}</s>
            </div>
            <span class="product-info__save-chip js-product-save-chip">Save 40%</span>
          </div>

          <!-- Commercial License on its own clean line -->
          <div class="product-info__license-line">
            <svg class="license-check-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span class="product-info__license-text">Commercial License Included</span>
            <button type="button" class="product-info__license-link js-license-modal-trigger" aria-label="View license terms">
              (View Terms)
            </button>
          </div>

          <!-- Product Description -->
          <p class="product-info__description js-product-description">
            {{ p_desc }}
          </p>

          <!-- Instant Digital Download Notification Banner -->
          <div class="instant-download-banner">
            <div class="instant-download-banner__icon">⚡</div>
            <div class="instant-download-banner__text">
              <strong>Instant Digital Download</strong>
              <span>Immediate ZIP file download after checkout + permanent backup link sent to your email.</span>
            </div>
          </div>

          <!-- Desktop Add to Cart AJAX Form -->
          <div class="product-desktop-atc-wrap">
            <form method="post" action="{{ routes.cart_add_url }}" class="product-form js-add-to-cart-form" enctype="multipart/form-data">
              <input type="hidden" name="id" class="js-product-variant-id" value="{{ current_product.selected_or_first_available_variant.id | default: '45000000001' }}">
              <input type="hidden" name="quantity" value="1">

              <div class="product-form__actions">
                <button type="submit" name="add" class="button button--primary product-add-btn js-add-to-cart-btn" aria-label="Add {{ p_title }} to cart">
                  <span class="btn-text js-btn-text">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: -3px; margin-right: 6px;" aria-hidden="true">
                      <circle cx="9" cy="21" r="1"></circle>
                      <circle cx="20" cy="21" r="1"></circle>
                      <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                    </svg>
                    Add to Cart &bull; <span class="js-btn-price-display">{{ p_price }}</span>
                  </span>
                  <span class="btn-loading js-btn-loading" style="display: none;">
                    <svg class="spinner-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M21 12a9 9 0 1 1-6.219-8.56"></path>
                    </svg>
                    Adding to Cart...
                  </span>
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- Mobile Sticky Bottom Checkout Bar -->
  <aside class="product-sticky-bar js-product-sticky-bar" aria-label="Quick checkout bar">
    <div class="product-sticky-bar__container">
      <div class="product-sticky-bar__info">
        {%- liquid
          assign p_sticky_img = ''
          if current_product.featured_image != blank
            assign p_sticky_img = current_product.featured_image | image_url: width: 140, height: 140, crop: 'center', format: 'webp'
          elsif current_product.images.first != blank
            assign p_sticky_img = current_product.images.first | image_url: width: 140, height: 140, crop: 'center', format: 'webp'
          elsif current_product.featured_media != blank
            assign p_sticky_img = current_product.featured_media | image_url: width: 140, height: 140, crop: 'center', format: 'webp'
          else
            assign p_sticky_img = 'mockup-geometric-pack.svg' | asset_url
          endif
        -%}
        <img 
          src="{{ p_sticky_img }}" 
          alt="{{ p_title | escape }} — thumbnail preview" 
          class="product-sticky-bar__thumb js-sticky-thumb" 
          width="48" 
          height="48" 
          loading="lazy"
        >
        <div class="product-sticky-bar__details">
          <span class="product-sticky-bar__title js-sticky-title">{{ p_title }}</span>
          <span class="product-sticky-bar__price js-sticky-price">{{ p_price }}</span>
        </div>
      </div>
      <button type="button" class="button button--primary product-sticky-bar__cta js-sticky-add-btn">
        Add to Cart
      </button>
    </div>
  </aside>

  <!-- Mini-Cart Confirmation Toast / Slide-out notification -->
  <aside class="mini-cart-toast js-cart-toast" role="status" aria-live="polite" hidden>
    <div class="mini-cart-toast__inner card glass-panel">
      <div class="mini-cart-toast__header">
        <div class="mini-cart-toast__title-wrap">
          <span class="mini-cart-toast__check">✓</span>
          <strong>Added to Cart!</strong>
        </div>
        <button type="button" class="mini-cart-toast__close js-close-toast" aria-label="Close notification">&times;</button>
      </div>
      <div class="mini-cart-toast__product">
        <img src="{{ 'mockup-geometric-pack.svg' | asset_url }}" alt="" class="mini-cart-toast__thumb js-toast-thumb" width="50" height="50">
        <div class="mini-cart-toast__desc">
          <span class="mini-cart-toast__p-title js-toast-title">{{ p_title }}</span>
          <span class="mini-cart-toast__p-price js-toast-price">{{ p_price }} &bull; Commercial License</span>
        </div>
      </div>
      <div class="mini-cart-toast__actions">
        <a href="{{ routes.cart_url }}" class="button button--secondary mini-cart-toast__btn-cart">View Cart</a>
        <a href="/checkout" class="button button--primary mini-cart-toast__btn-checkout">Checkout</a>
      </div>
    </div>
  </aside>

