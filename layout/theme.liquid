<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
  <meta name="theme-color" content="#6366F1">
  <link rel="canonical" href="{{ canonical_url }}">
  
  <title>
    {%- if request.path == '/pages/privacy' -%}
      Privacy Policy - Digvolly
    {%- elsif request.path == '/pages/terms' -%}
      Terms of Service - Digvolly
    {%- elsif request.path == '/pages/commercial-license' -%}
      Commercial License Rights - Digvolly
    {%- elsif request.path == '/pages/faq' -%}
      Download &amp; Format FAQs - Digvolly
    {%- elsif request.path == '/pages/contact' -%}
      Studio Support - Digvolly
    {%- else -%}
      {{ page_title }} - Digvolly
    {%- endif -%}
  </title>
  
  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}
  
  <!-- Google Fonts - Inter (Non-blocking async load with font-display: swap) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" media="print" onload="this.media='all'">
  <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap">
  </noscript>

  {{ 'base.css' | asset_url | stylesheet_tag }}

  {%- comment -%} Prioritize LCP image fetch in head {%- endcomment -%}
  {%- if template.name == 'index' -%}
    {%- assign lcp_product = nil -%}
    {%- for p in collections['all'].products -%}
      {%- unless p.handle == 'custom-6-asset-pack' or p.tags contains 'internal-bundle' or p.type == 'Bundle' -%}
        {%- assign lcp_product = p -%}
        {%- break -%}
      {%- endunless -%}
    {%- endfor -%}
    {%- if lcp_product != blank -%}
      {%- assign lcp_img = lcp_product.featured_media | default: lcp_product.featured_image -%}
      {%- if lcp_img != blank -%}
        {%- capture lcp_srcset -%}
          {{ lcp_img | image_url: width: 350, format: 'webp' }} 350w,
          {{ lcp_img | image_url: width: 450, format: 'webp' }} 450w,
          {{ lcp_img | image_url: width: 600, format: 'webp' }} 600w
        {%- endcapture -%}
        <link rel="preload" as="image" href="{{ lcp_img | image_url: width: 600, format: 'webp' }}" imagesrcset="{{ lcp_srcset | strip_newlines }}" imagesizes="(max-width: 480px) 350px, (max-width: 768px) 450px, 600px" fetchpriority="high" type="image/webp">
      {%- endif -%}
    {%- endif -%}
  {%- elsif template.name == 'product' -%}
    {%- if product != blank and product.featured_media != blank -%}
      <link rel="preload" as="image" href="{{ product.featured_media | image_url: width: 700, format: 'webp' }}" fetchpriority="high" type="image/webp">
    {%- endif -%}
  {%- endif -%}

  {%- if request.path contains '/products/custom-6-asset-pack' or product.handle == 'custom-6-asset-pack' or product.tags contains 'internal-bundle' -%}
    <meta name="robots" content="noindex, nofollow">
    <script>
      window.location.replace('/pages/build-a-pack');
    </script>
    <meta http-equiv="refresh" content="0; url=/pages/build-a-pack">
  {%- endif -%}

  {{ content_for_header }}
</head>

<body>
  <a class="skip-to-content-link button button--secondary" href="#MainContent">
    {{ 'accessibility.skip_to_text' | t }}
  </a>

  {% section 'header' %}

  <main id="MainContent" class="content-for-layout focus-outline" role="main">
    {%- if request.path == '/pages/privacy' -%}
      {% section 'main-privacy' %}
    {%- elsif request.path == '/pages/terms' -%}
      {% section 'main-terms' %}
    {%- elsif request.path == '/pages/commercial-license' -%}
      {% section 'main-commercial-license' %}
    {%- elsif request.path == '/pages/faq' -%}
      {% section 'main-faq' %}
    {%- elsif request.path == '/pages/contact' -%}
      {% section 'main-contact' %}
    {%- else -%}
      {{ content_for_layout }}
    {%- endif -%}
  </main>

  {% section 'footer' %}

  <ul hidden>
    <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
    <li id="a11y-new-window-message">{{ 'accessibility.link_messages.new_window' | t }}</li>
  </ul>

  <script>
    window.shopUrl = '{{ request.origin }}';
    window.routes = {
      cart_add_url: '{{ routes.cart_add_url }}',
      cart_change_url: '{{ routes.cart_change_url }}',
      predictives_search_url: '{{ routes.predictive_search_url }}',
      cart_url: '{{ routes.cart_url }}',
    };
    window.cartStrings = {
      error: `{{ 'sections.cart.cart_error' | t }}`,
      quantityError: `{{ 'sections.cart.quantity_error' | t }}`
    };
    window.variantStrings = {
      addToCart: `{{ 'products.product.add_to_cart' | t }}`,
      soldOut: `{{ 'products.product.sold_out' | t }}`,
      unavailable: `{{ 'products.product.unavailable' | t }}`
    };
  </script>

  {% render 'cookie-consent-banner' %}
</body>
</html>
