<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
  <meta name="theme-color" content="#6366F1">
  <link rel="canonical" href="{{ canonical_url }}">
  
  <title>
    {%- if template.name == 'index' -%}
      {%- if page_title != blank and page_title != 'My Store' and page_title != 'Digvolly' -%}
        {{ page_title }}
      {%- else -%}
        Digvolly — Premium Digital Design Assets for Creators
      {%- endif -%}
    {%- elsif request.path == '/pages/build-a-pack' -%}
      Build Your Custom Pack (6 Assets for $29) | Digvolly
    {%- elsif request.path == '/pages/privacy' -%}
      Privacy Policy — Digvolly
    {%- elsif request.path == '/pages/terms' -%}
      Terms of Service — Digvolly
    {%- elsif request.path == '/pages/commercial-license' -%}
      Commercial License Rights — Digvolly
    {%- elsif request.path == '/pages/faq' -%}
      Download &amp; Format FAQs — Digvolly
    {%- elsif request.path == '/pages/contact' -%}
      Studio Support — Digvolly
    {%- elsif page_title contains 'Digvolly' -%}
      {{ page_title }}
    {%- elsif template.name == 'product' and product != blank -%}
      {{ product.title }} — {{ product.type | default: 'Digital Asset' | capitalize }} | Digvolly
    {%- else -%}
      {{ page_title }} | Digvolly
    {%- endif -%}
  </title>
  
  {%- liquid
    assign meta_desc = page_description
    if template.name == 'index' and meta_desc == blank
      assign meta_desc = 'Shop premium seamless patterns, presentation templates & eBooks. Instant download, commercial license included. Build your own 6-pack and save 50%.'
    elsif request.path == '/pages/build-a-pack' and meta_desc == blank
      assign meta_desc = 'Build your own custom 6-asset pack and save 50%. Choose from seamless vector patterns, presentation decks, and eBooks. Commercial license included.'
    elsif template.name == 'collection' and meta_desc == blank
      assign meta_desc = 'Explore ' | append: collection.title | append: ' at Digvolly. Handcrafted digital design assets with commercial license and instant download.'
    elsif template.name == 'product' and meta_desc == blank and product != blank
      assign meta_desc = product.title | append: ' — Premium digital ' | append: product.type | default: 'design asset' | append: '. Includes commercial license and instant download.'
    endif
  -%}
  {% if meta_desc != blank %}
    <meta name="description" content="{{ meta_desc | strip | escape }}">
  {% endif %}
  
  {%- comment -%} Prioritize LCP image fetch in head with responsive imagesrcset & imagesizes {%- endcomment -%}
  {%- if template.name == 'index' -%}
    {%- assign lcp_product = nil -%}
    {%- for p in collections['all'].products -%}
      {%- unless p.handle == 'custom-6-asset-pack' or p.tags contains 'internal-bundle' or p.type == 'Bundle' -%}
        {%- assign lcp_product = p -%}
        {%- break -%}
      {%- endunless -%}
    {%- endfor -%}
    {%- if lcp_product != blank -%}
      {%- assign lcp_img = lcp_product.featured_media | default: lcp_product.featured_image -%}
      {%- if lcp_img != blank -%}
        {%- capture lcp_srcset -%}
          {{ lcp_img | image_url: width: 360, format: 'webp' }} 360w,
          {{ lcp_img | image_url: width: 540, format: 'webp' }} 540w,
          {{ lcp_img | image_url: width: 720, format: 'webp' }} 720w,
          {{ lcp_img | image_url: width: 900, format: 'webp' }} 900w,
          {{ lcp_img | image_url: width: 1200, format: 'webp' }} 1200w
        {%- endcapture -%}
        <link rel="preload" as="image" href="{{ lcp_img | image_url: width: 540, format: 'webp' }}" imagesrcset="{{ lcp_srcset | strip_newlines }}" imagesizes="(max-width: 480px) calc(100vw - 40px), (max-width: 768px) 350px, (max-width: 1024px) 45vw, 300px" fetchpriority="high" type="image/webp">
      {%- endif -%}
    {%- endif -%}
  {%- elsif template.name == 'collection' and collection.products.size > 0 -%}
    {%- assign lcp_product = nil -%}
    {%- for p in collection.products -%}
      {%- unless p.handle == 'custom-6-asset-pack' or p.tags contains 'internal-bundle' or p.type == 'Bundle' -%}
        {%- assign lcp_product = p -%}
        {%- break -%}
      {%- endunless -%}
    {%- endfor -%}
    {%- if lcp_product != blank -%}
      {%- assign lcp_img = lcp_product.featured_media | default: lcp_product.featured_image -%}
      {%- if lcp_img != blank -%}
        {%- capture lcp_srcset -%}
          {{ lcp_img | image_url: width: 360, format: 'webp' }} 360w,
          {{ lcp_img | image_url: width: 540, format: 'webp' }} 540w,
          {{ lcp_img | image_url: width: 720, format: 'webp' }} 720w,
          {{ lcp_img | image_url: width: 900, format: 'webp' }} 900w,
          {{ lcp_img | image_url: width: 1200, format: 'webp' }} 1200w
        {%- endcapture -%}
        <link rel="preload" as="image" href="{{ lcp_img | image_url: width: 540, format: 'webp' }}" imagesrcset="{{ lcp_srcset | strip_newlines }}" imagesizes="(max-width: 480px) calc(100vw - 40px), (max-width: 768px) 350px, (max-width: 1024px) 45vw, 300px" fetchpriority="high" type="image/webp">
      {%- endif -%}
    {%- endif -%}
  {%- elsif template.name == 'product' and product != blank -%}
    {%- assign prod_img = product.featured_media | default: product.featured_image -%}
    {%- if prod_img != blank -%}
      {%- capture prod_srcset -%}
        {{ prod_img | image_url: width: 360, format: 'webp' }} 360w,
        {{ prod_img | image_url: width: 540, format: 'webp' }} 540w,
        {{ prod_img | image_url: width: 720, format: 'webp' }} 720w,
        {{ prod_img | image_url: width: 900, format: 'webp' }} 900w,
        {{ prod_img | image_url: width: 1200, format: 'webp' }} 1200w
      {%- endcapture -%}
      <link rel="preload" as="image" href="{{ prod_img | image_url: width: 720, format: 'webp' }}" imagesrcset="{{ prod_srcset | strip_newlines }}" imagesizes="(max-width: 640px) 92vw, (max-width: 1024px) 48vw, 600px" fetchpriority="high" type="image/webp">
    {%- endif -%}
  {%- endif -%}

  <!-- Critical Above-The-Fold CSS -->
  <style id="critical-css">
    *, *::before, *::after { box-sizing: border-box; }
    html { -webkit-text-size-adjust: 100%; width: 100%; max-width: 100%; overflow-x: hidden; }
    body { margin: 0; padding: 0; width: 100%; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif !important; background: #fff; color: #1a1a1a; }
    .announcement-bar { background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%); color: #fff; text-align: center; padding: 8px 16px; font-size: 13px; font-weight: 600; }
    .announcement-bar a { color: #fff; text-decoration: none; }
    .header-wrapper { display: flex; align-items: center; justify-content: space-between; padding: 14px 20px; background: rgba(255,255,255,0.92); border-bottom: 1px solid rgba(0,0,0,0.06); }
    .header__heading { font-size: 20px; font-weight: 800; color: #111827; text-decoration: none; letter-spacing: -0.02em; }
    .digvolly-hero { padding: 40px 16px 28px; text-align: center; background: #fdfdfd; }
    .digvolly-hero__container { max-width: 900px; margin: 0 auto; }
    .hero-tag { display: inline-block; padding: 4px 12px; font-size: 12px; font-weight: 700; color: #4f46e5; background: #eef2ff; border-radius: 999px; text-transform: uppercase; margin-bottom: 12px; }
    .digvolly-hero__title { font-size: clamp(28px, 6vw, 48px); font-weight: 800; line-height: 1.15; color: #111827; margin: 0 0 12px; letter-spacing: -0.03em; }
    .digvolly-hero__subtitle { font-size: 16px; line-height: 1.5; color: #4b5563; margin: 0 0 20px; }
    .digvolly-hero__button { display: inline-flex; align-items: center; justify-content: center; padding: 12px 24px; font-size: 15px; font-weight: 600; color: #fff; background: #4f46e5; border-radius: 10px; text-decoration: none; }
    .collection-header { padding: 32px 16px 16px; max-width: 1280px; margin: 0 auto; }
    .collection-title { font-size: clamp(24px, 5vw, 36px); font-weight: 800; color: #111827; margin: 0 0 8px; }
    .collection-desc { font-size: 15px; color: #4b5563; line-height: 1.5; margin: 0 0 16px; }
    .products-container--grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px; }
    @media (max-width: 640px) {
      .products-container--grid { grid-template-columns: 1fr; }
      .digvolly-hero { padding: 28px 16px 20px; }
    }
    .product-card { background: #fff; border-radius: 12px; border: 1px solid #e5e7eb; overflow: hidden; display: flex; flex-direction: column; }
    .product-card__image-box { position: relative; width: 100%; aspect-ratio: 3 / 2; overflow: hidden; background: #f3f4f6; }
    .product-card__img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .product-gallery-main { position: relative; border-radius: 14px; background: #f9fafb; overflow: hidden; aspect-ratio: 3 / 2; }
    .product-gallery-main__img { width: 100%; height: 100%; object-fit: contain; display: block; }
  </style>

  <link rel="preload" href="{{ 'base.css' | asset_url }}" as="style">
  {{ 'base.css' | asset_url | stylesheet_tag }}

  <!-- Google Fonts - Inter (Preconnect + Font File Preload + font-display: swap) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" href="https://fonts.gstatic.com/s/inter/v20/UcC73FwrK3iLTeHuS_nVMrMxCp50SjIa1ZL7.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap">

  {%- if request.path contains '/products/custom-6-asset-pack' or product.handle == 'custom-6-asset-pack' or product.tags contains 'internal-bundle' -%}
    <meta name="robots" content="noindex, nofollow">
    <script>
      window.location.replace('/pages/build-a-pack');
    </script>
    <meta http-equiv="refresh" content="0; url=/pages/build-a-pack">
  {%- endif -%}

  {%- comment -%} Judge.me Product Reviews Core Integration {%- endcomment -%}
  {% render 'judgeme_core' %}

  {{ content_for_header }}
</head>

<body>
  <a class="skip-to-content-link button button--secondary" href="#MainContent">
    {{ 'accessibility.skip_to_text' | t }}
  </a>

  {% section 'announcement-bar' %}
  {% section 'header' %}

  <main id="MainContent" class="content-for-layout focus-outline" role="main">
    {%- if request.path == '/pages/privacy' -%}
      {% section 'main-privacy' %}
    {%- elsif request.path == '/pages/terms' -%}
      {% section 'main-terms' %}
    {%- elsif request.path == '/pages/commercial-license' -%}
      {% section 'main-commercial-license' %}
    {%- elsif request.path == '/pages/faq' -%}
      {% section 'main-faq' %}
    {%- elsif request.path == '/pages/contact' -%}
      {% section 'main-contact' %}
    {%- elsif request.path == '/pages/build-a-pack' -%}
      {% section 'build-a-pack' %}
    {%- else -%}
      {{ content_for_layout }}
    {%- endif -%}
  </main>

  {% section 'footer' %}

  <ul hidden>
    <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
    <li id="a11y-new-window-message">{{ 'accessibility.link_messages.new_window' | t }}</li>
  </ul>

  <script>
    window.shopUrl = '{{ request.origin }}';
    window.routes = {
      cart_add_url: '{{ routes.cart_add_url }}',
      cart_change_url: '{{ routes.cart_change_url }}',
      predictives_search_url: '{{ routes.predictive_search_url }}',
      cart_url: '{{ routes.cart_url }}',
    };
    window.cartStrings = {
      error: `{{ 'sections.cart.cart_error' | t }}`,
      quantityError: `{{ 'sections.cart.quantity_error' | t }}`
    };
    window.variantStrings = {
      addToCart: `{{ 'products.product.add_to_cart' | t }}`,
      soldOut: `{{ 'products.product.sold_out' | t }}`,
      unavailable: `{{ 'products.product.unavailable' | t }}`
    };
  </script>

  {% render 'cookie-consent-banner' %}
</body>
</html>
