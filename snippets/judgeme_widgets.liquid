{% comment %}
  Judge.me Widgets Dispatcher Snippet
  Supports:
  - widget_type: 'judgeme_review_widget' (Full reviews list, summary & write a review form)
  - widget_type: 'judgeme_preview_badge' (Star rating & review count badge)
  - widget_type: 'judgeme_verified_reviews_counter' (Verified reviews counter)
{% endcomment %}

{%- case widget_type -%}
  {%- when 'judgeme_review_widget' -%}
    <div style="clear:both"></div>
    <div id="judgeme_product_reviews" 
         class="jdgm-widget jdgm-review-widget" 
         data-product-title="{{ product.title | default: p_title | escape }}" 
         data-id="{{ product.id }}" 
         data-auto-install="false">
      {{ product.metafields.judgeme.widget }}
    </div>

  {%- when 'judgeme_preview_badge' -%}
    <div class="jdgm-widget jdgm-preview-badge" 
         data-id="{{ product.id }}" 
         data-template="{% if concise %}compact{% else %}manual-installation{% endif %}" 
         data-auto-install="false">
      {{ product.metafields.judgeme.badge }}
    </div>

  {%- when 'judgeme_verified_reviews_counter' -%}
    <div class="jdgm-widget jdgm-verified-badge">
      {{ shop.metafields.judgeme.verified_badge }}
    </div>
{%- endcase -%}
