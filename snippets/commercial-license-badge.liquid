<div class="license-badge-wrapper">
  <div class="commercial-license-badge js-license-modal-trigger" role="button" tabindex="0" aria-label="Commercial License Included - Click to view rights">
    <span class="commercial-license-badge__icon">🛡️</span>
    <div class="commercial-license-badge__text">
      <strong>Commercial License Included</strong>
      <span>Unlimited commercial &amp; client projects</span>
    </div>
    <span class="commercial-license-badge__info-btn" aria-hidden="true">ⓘ</span>
  </div>

  <!-- License Details Modal -->
  <div class="license-modal js-license-modal" role="dialog" aria-modal="true" aria-label="Digvolly Commercial License Terms">
    <div class="license-modal__content glass-panel card">
      <button type="button" class="license-modal__close js-license-modal-close" aria-label="Close modal">&times;</button>
      <div class="license-modal__header">
        <span class="license-modal__badge">Full Commercial Rights</span>
        <h2>Digvolly Commercial License</h2>
        <p>Simple, creator-friendly terms designed for freelancers, agencies, and studios.</p>
      </div>

      <div class="license-modal__body">
        <div class="license-clause">
          <h4>✅ What is 100% Permitted:</h4>
          <ul>
            <li>Use in unlimited personal and commercial client projects</li>
            <li>Use on physical merchandise, packaging, and textiles (up to 250,000 units)</li>
            <li>Use in websites, apps, social media campaigns, and digital advertising</li>
            <li>Full modification, recoloring, scaling, and remixing of source vectors</li>
            <li>No attribution or backlink required</li>
          </ul>
        </div>

        <div class="license-clause">
          <h4>❌ What is Strictly Prohibited:</h4>
          <ul>
            <li>Sub-licensing, reselling, sharing, or redistributing the original source files</li>
            <li>Claiming copyright ownership of unmodified design assets</li>
            <li>Uploading files to public stock sites or open repositories</li>
          </ul>
        </div>
      </div>

      <div class="license-modal__footer">
        <button type="button" class="button js-license-modal-close">Got It, Thanks</button>
      </div>
    </div>
  </div>
</div>
