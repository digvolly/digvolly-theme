{% comment %}
  Renders a digital product card with dual-image hover, dynamic badges, compare-at pricing, and neutral placeholder fallback.
  Accepts:
  - product: Product object (optional)
  - title: string (optional)
  - price: string (optional)
  - compare_at_price: string (optional)
  - badge: string (optional)
  - category: string (optional)
  - formats: string (optional, e.g. "AI, EPS, PNG")
  - primary_image: string / Image (optional)
  - secondary_image: string / Image (optional)
  - url: string (optional)
{% endcomment %}

{%- unless product.handle == 'custom-6-asset-pack' or product.tags contains 'internal-bundle' or product.type == 'Bundle' or handle == 'custom-6-asset-pack' -%}
{%- liquid
  assign card_title = title | default: product.title | default: 'Digital Creative Asset'
  if product != blank and product.url != blank
    assign card_url = product.url
  elsif url != blank
    assign card_url = url
  elsif product != blank and product.handle != blank
    assign card_url = '/products/' | append: product.handle
  elsif handle != blank and handle != 'all' and handle != 'collection' and handle != 'index' and handle != '404'
    assign card_url = '/products/' | append: handle
  else
    assign card_url = routes.all_products_collection_url
  endif
  assign raw_category = category | default: product.type | default: ''
  assign raw_lower = raw_category | downcase

  if raw_lower == 'ebooks' or raw_lower == 'ebook' or raw_lower contains 'ebook' or raw_lower contains 'book' or raw_lower contains 'guide' or raw_lower contains 'playbook'
    assign card_category = 'eBooks'
  elsif raw_lower == 'patterns' or raw_lower == 'pattern' or raw_lower contains 'pattern' or raw_lower contains 'paper' or raw_lower contains 'texture'
    assign card_category = 'Patterns'
  elsif raw_lower == 'presentation templates' or raw_lower contains 'presentation' or raw_lower contains 'template' or raw_lower contains 'deck' or raw_lower contains 'kit'
    assign card_category = 'Presentation Templates'
  else
    assign matched_from_tag = ''
    if product != blank
      for tag in product.tags
        assign tag_lower = tag | downcase
        if tag_lower contains 'ebook' or tag_lower contains 'book'
          assign matched_from_tag = 'eBooks'
          break
        elsif tag_lower contains 'pattern' or tag_lower contains 'paper'
          assign matched_from_tag = 'Patterns'
          break
        elsif tag_lower contains 'presentation' or tag_lower contains 'template'
          assign matched_from_tag = 'Presentation Templates'
          break
        endif
      endfor
    endif
    if matched_from_tag != blank
      assign card_category = matched_from_tag
    elsif raw_lower contains 'graphic' or raw_lower contains '3d'
      assign card_category = 'eBooks'
    else
      assign card_category = 'Presentation Templates'
    endif
  endif

  if price != blank
    assign card_price = price
    assign card_compare_price = compare_at_price | default: '$25.00'
  elsif product != blank and product.price > 0
    assign card_price = product.price | money
    if product.compare_at_price > product.price
      assign card_compare_price = product.compare_at_price | money
    else
      assign card_compare_price = '$25.00'
    endif
  else
    assign card_price = '$15.00'
    assign card_compare_price = compare_at_price | default: '$25.00'
  endif

  assign card_badge = ''
  if badge != blank
    assign card_badge = badge
  elsif product != blank
    if product.metafields.custom.badge != blank
      assign card_badge = product.metafields.custom.badge
    else
      for tag in product.tags
        assign downcase_tag = tag | downcase
        if downcase_tag contains 'badge:'
          assign card_badge = tag | split: 'badge:' | last | strip
          break
        elsif downcase_tag == 'bestseller' or downcase_tag == 'best seller'
          assign card_badge = 'Bestseller'
          break
        elsif downcase_tag == 'new' or downcase_tag == 'new arrival'
          assign card_badge = 'New'
          break
        elsif downcase_tag contains 'save' or downcase_tag contains '%'
          assign card_badge = tag | strip
          break
        endif
      endfor
    endif

    if card_badge == blank and product.compare_at_price > product.price
      assign savings = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round
      assign card_badge = 'Save ' | append: savings | append: '%'
    endif
  endif

  assign badge_class = 'product-card__badge--default'
  assign badge_lower = card_badge | downcase
  if badge_lower contains 'save' or badge_lower contains '%'
    assign badge_class = 'product-card__badge--save'
  elsif badge_lower contains 'new'
    assign badge_class = 'product-card__badge--new'
  elsif badge_lower contains 'best'
    assign badge_class = 'product-card__badge--bestseller'
  endif

  assign primary_img_src = ''
  assign primary_srcset = ''
  assign primary_media_obj = nil
  if product.featured_media != blank
    assign primary_media_obj = product.featured_media
  elsif product.featured_image != blank
    assign primary_media_obj = product.featured_image
  elsif product.images.size > 0
    assign primary_media_obj = product.images.first
  endif

  if primary_media_obj != blank
    assign primary_img_src = primary_media_obj | image_url: width: 400, format: 'webp'
    capture primary_srcset
      echo primary_media_obj | image_url: width: 320, format: 'webp'
      echo ' 320w, '
      echo primary_media_obj | image_url: width: 400, format: 'webp'
      echo ' 400w, '
      echo primary_media_obj | image_url: width: 500, format: 'webp'
      echo ' 500w, '
      echo primary_media_obj | image_url: width: 640, format: 'webp'
      echo ' 640w'
    endcapture
  elsif primary_image != blank
    if primary_image contains '/' or primary_image contains 'http'
      assign primary_img_src = primary_image
    else
      assign primary_img_src = primary_image | asset_url
    endif
  endif

  if primary_img_src == blank
    assign primary_img_src = 'mockup-geometric-pack.svg' | asset_url
  endif

  assign has_hover_image = false
  assign secondary_img_src = ''
  assign secondary_srcset = ''
  if product != blank and product.images.size > 1 and product.images[1] != blank
    assign secondary_img_src = product.images[1] | image_url: width: 450, format: 'webp'
    capture secondary_srcset
      echo product.images[1] | image_url: width: 350, format: 'webp'
      echo ' 350w, '
      echo product.images[1] | image_url: width: 450, format: 'webp'
      echo ' 450w, '
      echo product.images[1] | image_url: width: 600, format: 'webp'
      echo ' 600w'
    endcapture
    assign has_hover_image = true
  elsif secondary_image != blank
    if secondary_image contains '/' or secondary_image contains 'http'
      assign secondary_img_src = secondary_image
    else
      assign secondary_img_src = secondary_image | asset_url
    endif
    assign has_hover_image = true
  endif

  assign card_formats = formats
  if card_formats == blank and product != blank
    for tag in product.tags
      assign tag_up = tag | upcase
      if tag_up == 'AI' or tag_up == 'EPS' or tag_up == 'SVG' or tag_up == 'PNG' or tag_up == 'PPTX' or tag_up == 'KEY' or tag_up == 'FIGMA' or tag_up == 'PSD'
        if card_formats == blank
          assign card_formats = tag_up
        else
          assign card_formats = card_formats | append: ', ' | append: tag_up
        endif
      endif
    endfor
  endif
-%}

<div class="product-card js-collection-item {% if has_hover_image %}product-card--has-hover-image{% else %}product-card--single-image{% endif %}" data-category="{{ card_category | escape }}" data-formats="{{ card_formats | escape }}" data-style="{{ card_title | escape }}">
  <div class="product-card__image-container">
    <a href="{{ card_url }}" class="product-card__media-link" aria-label="{{ card_title | escape }}">
      <div class="product-card__image-box">
        {%- capture card_primary_alt -%}
          {%- if product.featured_media.alt != blank and product.featured_media.alt != product.title -%}
            {{ product.featured_media.alt }}
          {%- else -%}
            {{ card_title }} — {{ card_category | default: 'digital design asset' }} preview
          {%- endif -%}
        {%- endcapture -%}
        {%- capture card_secondary_alt -%}
          {{ card_title }} — {{ card_category | default: 'digital design asset' }} detail view
        {%- endcapture -%}
        <img 
          src="{{ primary_img_src }}" 
          {% if primary_srcset != blank %}srcset="{{ primary_srcset }}" sizes="(max-width: 480px) calc(100vw - 40px), (max-width: 768px) 350px, (max-width: 1024px) 45vw, 300px"{% endif %}
          alt="{{ card_primary_alt | strip | escape }}" 
          class="product-card__img product-card__img--primary"
          width="600" 
          height="400" 
          loading="{% if is_lcp %}eager{% else %}lazy{% endif %}"
          {% if is_lcp %}fetchpriority="high"{% endif %}
          decoding="async"
          style="object-fit: cover;"
        >
        {%- if has_hover_image and secondary_img_src != blank -%}
          <picture class="product-card__secondary-picture">
            <source media="(hover: hover) and (min-width: 769px)" {% if secondary_srcset != blank %}srcset="{{ secondary_srcset }}" sizes="(max-width: 480px) 350px, (max-width: 768px) 450px, 600px"{% else %}srcset="{{ secondary_img_src }}"{% endif %}>
            <img 
              src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg'/%3E" 
              alt="{{ card_secondary_alt | strip | escape }}" 
              class="product-card__img product-card__img--secondary"
              width="600" 
              height="400" 
              loading="lazy"
              decoding="async"
              style="object-fit: cover;"
            >
          </picture>
        {%- endif -%}
      </div>
    </a>
    <span class="product-card__category-badge">{{ card_category }}</span>
  </div>

  <div class="product-card__content">
    <h3 class="product-card__title">
      <a href="{{ card_url }}">{{ card_title }}</a>
    </h3>

    <div class="product-card__meta">
      {%- if product != blank and product.id != blank -%}
        <div class="product-card__reviews js-card-reviews" data-product-id="{{ product.id }}">
          {% render 'judgeme_widgets', widget_type: 'judgeme_preview_badge', concise: true, concierge_install: true, product: product %}
        </div>
      {%- endif -%}
      <div class="product-card__price-row">
        <span class="product-card__price">{{ card_price }}</span>
        {% if card_compare_price != blank %}
          <s class="product-card__compare-price">{{ card_compare_price }}</s>
        {% endif %}
      </div>
      <div class="product-card__license-tag">
        <svg class="license-check-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span>Commercial License Included</span>
      </div>
    </div>

    <a href="{{ card_url }}" class="product-card__button">
      View Pack Details
    </a>
  </div>
</div>
{%- endunless -%}
