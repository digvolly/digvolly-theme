{% comment %}
  Renders the Buy 1 Get 4 Free promotion progress & message banner for Cart page and drawers.
  Accepts:
  - is_drawer: boolean (optional)
{% endcomment %}

{%- liquid
  assign enable_banner = true
  if section.settings.enable_bogo_message == false
    assign enable_banner = false
  elsif settings.bogo_enable == false or settings.bogo_show_cart_msg == false
    assign enable_banner = false
  endif

  assign msg_1 = section.settings.bogo_msg_1 | default: settings.bogo_cart_msg_1 | default: "Add 4 more templates — they're FREE! Browse the collection"
  assign btn_text = section.settings.bogo_btn_text | default: settings.bogo_cart_btn_text | default: "Browse the collection"
  assign btn_url = section.settings.bogo_btn_url | default: settings.bogo_cart_btn_url | default: "/collections/all"
  assign msg_range = section.settings.bogo_msg_range | default: settings.bogo_cart_msg_range | default: "Add {N} more to get all 4 FREE"
  assign msg_5 = section.settings.bogo_msg_5 | default: settings.bogo_cart_msg_5 | default: "Congratulations! You got 4 FREE templates 🎉"

  assign eligible_count = 0
  for item in cart.items
    assign is_bundle = false
    if item.product.handle == 'custom-6-asset-pack' or item.product.title contains 'Custom 6-Asset Pack' or item.handle == 'custom-6-asset-pack' or item.title contains 'Custom 6-Asset Pack'
      assign is_bundle = true
    endif
    if item.product.tags contains 'internal-bundle' or item.product.type == 'Bundle'
      assign is_bundle = true
    endif
    if item.properties['_PackType'] != blank
      assign is_bundle = true
    endif
    unless is_bundle
      assign eligible_count = eligible_count | plus: item.quantity
    endunless
  endfor

  assign remaining = 5 | minus: eligible_count
  if remaining < 0
    assign remaining = 0
  endif

  assign progress_percent = eligible_count | times: 100 | divided_by: 5
  if progress_percent > 100
    assign progress_percent = 100
  endif
-%}

{%- if enable_banner -%}
  <div 
    class="cart-bogo-banner card glass-panel js-cart-bogo-banner {% if eligible_count >= 5 %}is-unlocked{% elsif eligible_count > 0 %}is-active{% else %}is-hidden{% endif %}" 
    data-eligible-count="{{ eligible_count }}"
    data-msg-1="{{ msg_1 | escape }}"
    data-msg-range="{{ msg_range | escape }}"
    data-msg-5="{{ msg_5 | escape }}"
    data-btn-text="{{ btn_text | escape }}"
    data-btn-url="{{ btn_url | escape }}"
    role="region" 
    aria-label="Promotion status"
    {% if eligible_count == 0 %}style="display: none;"{% endif %}
  >
    <div class="cart-bogo-banner__main">
      <div class="cart-bogo-banner__header">
        <div class="cart-bogo-banner__icon-wrap">
          {%- if eligible_count >= 5 -%}
            <span class="cart-bogo-banner__icon">🎉</span>
          {%- else -%}
            <span class="cart-bogo-banner__icon">🎁</span>
          {%- endif -%}
        </div>
        <div class="cart-bogo-banner__copy">
          <div class="cart-bogo-banner__pill">
            {%- if eligible_count >= 5 -%}
              Special Offer Applied
            {%- else -%}
              Buy 1 Get 4 FREE Deal
            {%- endif -%}
          </div>
          <h2 class="cart-bogo-banner__message js-bogo-message">
            {%- if eligible_count == 1 -%}
              {{ msg_1 }}
            {%- elsif eligible_count >= 2 and eligible_count <= 4 -%}
              {{ msg_range | replace: '{N}', remaining }}
            {%- elsif eligible_count >= 5 -%}
              {{ msg_5 }}
            {%- endif -%}
          </h2>
        </div>
      </div>

      <div class="cart-bogo-banner__actions js-bogo-actions" {% unless eligible_count == 1 %}style="display: none;"{% endunless %}>
        <a href="{{ btn_url }}" class="button button--primary cart-bogo-banner__btn">
          {{ btn_text }} &rarr;
        </a>
      </div>
    </div>

    <!-- Visual Progress Meter -->
    <div class="cart-bogo-banner__progress-wrap" aria-hidden="true">
      <div class="cart-bogo-banner__progress-bar">
        <div class="cart-bogo-banner__progress-fill js-bogo-progress-fill" style="width: {{ progress_percent }}%;"></div>
      </div>
      <div class="cart-bogo-banner__progress-labels">
        <span class="cart-bogo-banner__progress-step {% if eligible_count >= 1 %}is-reached{% endif %}">1</span>
        <span class="cart-bogo-banner__progress-step {% if eligible_count >= 2 %}is-reached{% endif %}">2</span>
        <span class="cart-bogo-banner__progress-step {% if eligible_count >= 3 %}is-reached{% endif %}">3</span>
        <span class="cart-bogo-banner__progress-step {% if eligible_count >= 4 %}is-reached{% endif %}">4</span>
        <span class="cart-bogo-banner__progress-step cart-bogo-banner__progress-step--goal {% if eligible_count >= 5 %}is-reached{% endif %}">5 (4 FREE)</span>
      </div>
    </div>
  </div>
{%- endif -%}
