{% comment %}
  Renders an interactive selectable card for Build-a-Pack
  Accepts:
  - id: variant or item id
  - title: item title
  - category: category tag
  - formats: formats tag (e.g. 'AI, EPS, SVG, PNG')
  - primary_image: image asset
  - secondary_image: hover image asset
  - price: item individual price (default '$15.00')
  - variant_id: Shopify variant ID (optional)
{% endcomment %}

{%- liquid
  assign primary_img_src = ''
  if product != blank and product.featured_media != blank
    assign primary_img_src = product.featured_media | image_url: width: 600
  elsif product != blank and product.featured_image != blank
    assign primary_img_src = product.featured_image | image_url: width: 600
  elsif primary_image != blank
    if primary_image.src != blank or primary_image.width != blank
      assign primary_img_src = primary_image | image_url: width: 600
    elsif primary_image contains '//' or primary_image contains 'http' or primary_image contains 'cdn.shopify.com' or primary_image contains 'files/'
      assign primary_img_src = primary_image
    else
      assign primary_img_src = primary_image | asset_url
    endif
  endif

  if primary_img_src == blank
    assign primary_img_src = 'mockup-geometric-pack.svg' | asset_url
  endif

  assign has_secondary = false
  assign secondary_img_src = ''
  if product != blank and product.images.size > 1 and product.images[1] != blank
    assign secondary_img_src = product.images[1] | image_url: width: 600
    assign has_secondary = true
  elsif secondary_image != blank
    if secondary_image.src != blank or secondary_image.width != blank
      assign secondary_img_src = secondary_image | image_url: width: 600
      assign has_secondary = true
    elsif secondary_image contains '//' or secondary_image contains 'http' or secondary_image contains 'cdn.shopify.com' or secondary_image contains 'files/'
      assign secondary_img_src = secondary_image
      assign has_secondary = true
    else
      assign secondary_img_src = secondary_image | asset_url
      assign has_secondary = true
    endif
  endif
-%}

<div 
  class="pack-item-card product-card {% if has_secondary and secondary_img_src != blank %}pack-item-card--has-hover-image product-card--has-hover-image{% else %}pack-item-card--single-image product-card--single-image{% endif %}" 
  data-id="{{ id | escape }}" 
  data-variant-id="{{ variant_id | default: id | escape }}"
  data-title="{{ title | escape }}" 
  data-category="{{ category | escape }}" 
  data-formats="{{ formats | escape }}"
  data-price="{{ price | default: '$15.00' | escape }}"
  role="checkbox"
  aria-checked="false"
  tabindex="0"
>
  <div class="product-card__image-container">
    <!-- Corner Checkmark Badge -->
    <div class="pack-card__check-badge" aria-hidden="true">
      <svg class="pack-card__check-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
    </div>

    <!-- Category Pill -->
    <span class="product-card__category-badge">{{ category }}</span>

    <!-- Image Container with Hover Preview -->
    <div class="product-card__image-box">
      <img 
        src="{{ primary_img_src }}" 
        alt="{{ title | escape }}" 
        class="product-card__img product-card__img--primary"
        width="600" 
        height="400" 
        loading="lazy"
        style="object-fit: cover;"
      >
      {%- if has_secondary and secondary_img_src != blank -%}
        <img 
          src="{{ secondary_img_src }}" 
          alt="{{ title | escape }} - Preview" 
          class="product-card__img product-card__img--secondary"
          width="600" 
          height="400" 
          loading="lazy"
          style="object-fit: cover;"
        >
      {%- endif -%}
    </div>
  </div>

  <div class="product-card__content">
    <h3 class="product-card__title">
      {{ title }}
    </h3>

    <div class="product-card__meta">
      <div class="product-card__price-row">
        <span class="product-card__price">{{ price | default: '$15.00' }}</span>
        <span class="pack-card__value-note">Individual value</span>
      </div>
      <div class="product-card__license-tag">
        <svg class="license-check-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span>Commercial License Included</span>
      </div>
    </div>

    <button type="button" class="pack-item-card__select-btn" aria-label="Select {{ title | escape }}">
      <span class="btn-text-add">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: -1px; margin-right: 4px;">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
        Add to Pack
      </span>
      <span class="btn-text-selected">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: -2px; margin-right: 4px;">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        Selected
      </span>
      <span class="btn-text-disabled">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: -1px; margin-right: 4px;">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
        </svg>
        Pack Full (6/6)
      </span>
    </button>
  </div>
</div>
