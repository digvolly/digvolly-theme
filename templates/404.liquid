<div id="build-a-pack-fallback" style="display: none;">
  {% section 'build-a-pack' %}
</div>

<div id="product-page-fallback" style="display: none;">
  {% section 'main-product' %}
  {% section 'related-products' %}
</div>

<div id="privacy-fallback" style="display: none;">
  {% section 'main-privacy' %}
</div>

<div id="terms-fallback" style="display: none;">
  {% section 'main-terms' %}
</div>

<div id="commercial-license-fallback" style="display: none;">
  {% section 'main-commercial-license' %}
</div>

<div id="faq-fallback" style="display: none;">
  {% section 'main-faq' %}
</div>

<div id="contact-fallback" style="display: none;">
  {% section 'main-contact' %}
</div>

<div id="default-404" class="template-404 text-center" style="padding: 100px 40px;">
  <h1 style="font-size: 36px; font-weight: 800; color: #111827; margin-bottom: 12px;">404 — Page Not Found</h1>
  <p style="font-size: 16px; color: #4B5563; margin-bottom: 24px;">The page you were looking for does not exist.</p>
  <a href="{{ routes.all_products_collection_url }}" class="button">
    Continue Shopping
  </a>
</div>

<script>
  (function() {
    var path = window.location.pathname;
    var default404 = document.getElementById('default-404');

    function showSection(id, title) {
      if (title) document.title = title;
      var el = document.getElementById(id);
      if (el) el.style.display = 'block';
      if (default404) default404.style.display = 'none';
    }

    if (path.indexOf('/pages/build-a-pack') !== -1) {
      showSection('build-a-pack-fallback', 'Build Your Custom Pack - Digvolly');
    } else if (path.indexOf('/pages/privacy') !== -1) {
      showSection('privacy-fallback', 'Privacy Policy - Digvolly');
    } else if (path.indexOf('/pages/terms') !== -1) {
      showSection('terms-fallback', 'Terms of Service - Digvolly');
    } else if (path.indexOf('/pages/commercial-license') !== -1) {
      showSection('commercial-license-fallback', 'Commercial License Rights - Digvolly');
    } else if (path.indexOf('/pages/faq') !== -1) {
      showSection('faq-fallback', 'Download & Format FAQs - Digvolly');
    } else if (path.indexOf('/pages/contact') !== -1) {
      showSection('contact-fallback', 'Studio Support - Digvolly');
    } else if (path.indexOf('/products/') !== -1) {
      var prodFallback = document.getElementById('product-page-fallback');
      if (prodFallback) prodFallback.style.display = 'block';
      if (default404) default404.style.display = 'none';
    }
  })();
</script>
